# Pera Wallet — LocalNet overlay
#
# Applied on top of .env by `pnpm localnet:use` (tools/use-localnet.sh), which
# also injects the live TESTNET_GENESIS_HASH from the running node. Points the
# app's TESTNET slot at a local AlgoKit LocalNet. Mainnet is deliberately left
# untouched so it stays on live infrastructure.
#
# Values here use the UNPREFIXED names that tools/generate-config.sh reads.

TESTNET_ALGOD_URL=http://localhost:4001
TESTNET_INDEXER_URL=http://localhost:8980

# LocalNet's fixed public dev token (64 x 'a'). Not a secret.
ALGOD_API_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
INDEXER_API_KEY=

DEFAULT_NETWORK=testnet
