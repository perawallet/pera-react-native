#!/bin/sh
# Pre-push hook for code checks, formatting, copyright checking, and testing

echo "Running pre-push checks..."

FAIL_ON_ERROR=1
if [ "$1" = "--no-fail-on-error" ]; then
    echo "Skipping pre-push checks failure enforcement..."
    FAIL_ON_ERROR=0
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Initialize variables for error handling
EXIT_STATUS=0
ERROR_REPORT=$(mktemp)

# Helper function to record failures
record_failure() {
    TITLE="$1"
    LOG_FILE="$2"
    EXTRA_MSG="$3"

    echo "" >> "$ERROR_REPORT"
    echo "${RED}========================================${NC}" >> "$ERROR_REPORT"
    echo "${RED}FAILED: $TITLE${NC}" >> "$ERROR_REPORT"
    echo "${RED}========================================${NC}" >> "$ERROR_REPORT"
    
    if [ ! -z "$EXTRA_MSG" ]; then
        echo "$EXTRA_MSG" >> "$ERROR_REPORT"
        echo "" >> "$ERROR_REPORT"
    fi
    
    if [ -f "$LOG_FILE" ]; then
        cat "$LOG_FILE" >> "$ERROR_REPORT"
    fi
    
    EXIT_STATUS=1
}

# Run Oxlint checks
echo "\n${YELLOW}Running code checks...${NC}"
LINT_LOG=$(mktemp)
if pnpm run lint > "$LINT_LOG" 2>&1; then
    echo "${GREEN}✓ Code checks passed${NC}"
else
    echo "${RED}Code checks failed.${NC}"
    record_failure "Lint" "$LINT_LOG" "${YELLOW}You can run 'pnpm lint:fix' to auto-fix some issues.${NC}"
fi
rm "$LINT_LOG"

# Run type-aware lint (no-floating-promises / no-misused-promises).
# These rules require full type information and are much slower than the
# default lint, so they live in a separate step.
echo "\n${YELLOW}Running type-aware lint...${NC}"
TYPES_LOG=$(mktemp)
if pnpm run lint:types > "$TYPES_LOG" 2>&1; then
    echo "${GREEN}✓ Type-aware lint passed${NC}"
else
    echo "${RED}Type-aware lint failed.${NC}"
    record_failure "Type-aware lint (floating/misused promises)" "$TYPES_LOG"
fi
rm "$TYPES_LOG"

# Run formatter
echo "\n${YELLOW}Running formatter...${NC}"
FORMAT_LOG=$(mktemp)
if pnpm run format > "$FORMAT_LOG" 2>&1; then
    # Check for modified files after formatting
    if ! git diff --quiet; then
        echo "${RED}Formatting detected changes.${NC}"
        DIFF_LOG=$(mktemp)
        # Capture the names of changed files
        echo "The following files were modified by the formatter:" > "$DIFF_LOG"
        git diff --name-only >> "$DIFF_LOG"
        
        record_failure "Formatter (Uncommitted Changes)" "$DIFF_LOG" "${YELLOW}Please commit these changes before pushing.${NC}"
        rm "$DIFF_LOG"
    else
        echo "${GREEN}✓ Formatting passed${NC}"
    fi
else
    echo "${RED}Formatting execution failed.${NC}"
    record_failure "Formatter Execution" "$FORMAT_LOG"
fi
rm "$FORMAT_LOG"

# Run copyright header check
echo "\n${YELLOW}Checking copyright headers...${NC}"
COPYRIGHT_LOG=$(mktemp)
if pnpm run lint:copyright > "$COPYRIGHT_LOG" 2>&1; then
    # Check for modified files after copyright header check
    if ! git diff --quiet; then
        echo "${RED}Copyright header check detected changes.${NC}"
        DIFF_LOG=$(mktemp)
        echo "The following files had copyright headers updated:" > "$DIFF_LOG"
        git diff --name-only >> "$DIFF_LOG"
        
        record_failure "Copyright Headers (Uncommitted Changes)" "$DIFF_LOG" "${YELLOW}Please commit these changes before pushing.${NC}"
        rm "$DIFF_LOG"
    else
        echo "${GREEN}✓ Copyright headers valid${NC}"
    fi
else
    echo "${RED}Copyright header check failed.${NC}"
    record_failure "Copyright Check" "$COPYRIGHT_LOG" "${YELLOW}Please ensure all files have the proper copyright header.${NC}"
fi
rm "$COPYRIGHT_LOG"

# Run single-algosdk guard. pnpm's peer-dependency auto-install can bypass
# the workspace-level algosdk override for any importer with no direct
# algosdk edge, silently reintroducing a second, stock algosdk resolution
# (see tools/check-single-algosdk.mjs's header for the incident that proved
# this isn't hypothetical).
echo "\n${YELLOW}Checking for a single resolved algosdk...${NC}"
ALGOSDK_LOG=$(mktemp)
if pnpm run check:single-algosdk > "$ALGOSDK_LOG" 2>&1; then
    echo "${GREEN}✓ Single algosdk resolution${NC}"
else
    echo "${RED}Single-algosdk check failed.${NC}"
    record_failure "Single algosdk resolution" "$ALGOSDK_LOG" "${YELLOW}A second algosdk resolution was found — see the log below for offending importers.${NC}"
fi
rm "$ALGOSDK_LOG"

# Run kms PQ-provider packaging guard. Quantum accounts pick their Falcon
# backend at build time; if the react-native export condition or the native
# build pass goes away, mobile silently signs with WASM Falcon and every test
# stays green (see tools/check-kms-pq-dist.mjs's header).
echo "\n${YELLOW}Checking kms PQ provider packaging...${NC}"
KMS_PQ_LOG=$(mktemp)
if pnpm run check:kms-pq-dist > "$KMS_PQ_LOG" 2>&1; then
    echo "${GREEN}✓ kms PQ provider packaging valid${NC}"
else
    echo "${RED}kms PQ provider check failed.${NC}"
    record_failure "kms PQ provider packaging" "$KMS_PQ_LOG" "${YELLOW}Mobile would resolve the off-device Falcon provider — see the log below.${NC}"
fi
rm "$KMS_PQ_LOG"

# Run declaration-emit wiring guard. Each package emits its own .d.ts through
# tsconfig.build.json, and both ways that breaks are silent: a package with no
# build config publishes an untyped import, and a brace glob in `exclude` is
# ignored by tsconfig rather than rejected (see tools/check-dts-emit.mjs).
echo "\n${YELLOW}Checking declaration emit wiring...${NC}"
DTS_LOG=$(mktemp)
if pnpm run check:dts-emit > "$DTS_LOG" 2>&1; then
    echo "${GREEN}✓ declaration emit wiring valid${NC}"
else
    echo "${RED}declaration emit check failed.${NC}"
    record_failure "declaration emit wiring" "$DTS_LOG" "${YELLOW}A package would publish types it never emits — see the log below.${NC}"
fi
rm "$DTS_LOG"

# Run i18n check
echo "\n${YELLOW}Checking i18n...${NC}"
I18N_LOG=$(mktemp)
if pnpm run lint:i18n > "$I18N_LOG" 2>&1; then
    echo "${GREEN}✓ i18n valid${NC}"
else
    echo "${RED}i18n check failed.${NC}"
    record_failure "i18n Check" "$I18N_LOG" "${YELLOW}Please ensure all files have the proper i18n.${NC}"
fi
rm "$I18N_LOG"

# Doc hygiene. Blocks on wrongness (a path that no longer exists, a dead link,
# a reference to a work item nobody will be able to look up); reports on length
# without blocking, because that needs a human's judgement.
echo "\n${YELLOW}Checking doc hygiene...${NC}"
DOCS_LOG=$(mktemp)
if pnpm run lint:docs > "$DOCS_LOG" 2>&1; then
    echo "${GREEN}✓ docs and comments clean${NC}"
else
    echo "${RED}Doc hygiene check failed.${NC}"
    record_failure "Doc Hygiene" "$DOCS_LOG" "${YELLOW}Fix the stale reference, or record an exception with a reason.${NC}"
fi
rm "$DOCS_LOG"

# Secret scan. The CI job is authoritative; this catches obvious leaks
# before they hit the network. Soft-skip if gitleaks isn't installed so
# new contributors aren't blocked on install friction.
echo "\n${YELLOW}Scanning for committed secrets...${NC}"
if command -v gitleaks >/dev/null 2>&1; then
    GITLEAKS_LOG=$(mktemp)
    UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "origin/main")
    if gitleaks git --config=.gitleaks.toml --log-opts="${UPSTREAM}..HEAD" --redact > "$GITLEAKS_LOG" 2>&1; then
        echo "${GREEN}✓ No secrets detected${NC}"
    else
        record_failure "Gitleaks" "$GITLEAKS_LOG" "${YELLOW}Remove the leaked secret, rotate it, and rewrite history before pushing.${NC}"
    fi
    rm "$GITLEAKS_LOG"
else
    echo "${YELLOW}⚠ gitleaks not installed — skipping local secret scan.${NC}"
    echo "${YELLOW}  Install with 'brew install gitleaks' (CI will still check).${NC}"
fi

# Final Report
if [ $EXIT_STATUS -ne 0 ]; then
    echo "\n${RED}Some pre-push checks failed:${NC}"
    cat "$ERROR_REPORT"
    rm "$ERROR_REPORT"
    
    if [ $FAIL_ON_ERROR -ne 0 ]; then
        exit 1
    fi
else
    echo "\n${GREEN}All pre-push checks passed!${NC}"
    rm "$ERROR_REPORT"
    exit 0
fi
