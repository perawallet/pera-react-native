{
  "manifest_version": 3,
  "name": "Pera Wallet",
  "version": "0.1.0",
  "description": "Algorand wallet by Pera — browser extension (development build)",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pera Wallet"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"]
}
