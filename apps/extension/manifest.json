{
  "manifest_version": 3,
  "name": "Pera Wallet",
  "version": "0.1.0",
  "description": "Algorand wallet by Pera — browser extension (development build)",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pera Wallet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-inject-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-relay-isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://discover-mobile.perawallet.app/*",
        "https://discover-mobile-staging.perawallet.app/*"
      ],
      "js": ["content-discover-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://discover-mobile.perawallet.app/*",
        "https://discover-mobile-staging.perawallet.app/*"
      ],
      "js": ["content-discover-relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "https://commerce.bidali.com/*",
        "https://commerce.staging.bidali.com/*",
        "https://giftcards.bidali.com/*",
        "https://giftcards.staging.bidali.com/*"
      ],
      "js": ["content-bidali-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://commerce.bidali.com/*",
        "https://commerce.staging.bidali.com/*",
        "https://giftcards.bidali.com/*",
        "https://giftcards.staging.bidali.com/*"
      ],
      "js": ["content-bidali-relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-webauthn-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-webauthn-relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "alarms", "offscreen"],
  "host_permissions": [
    "https://*.perawallet.app/*",
    "https://*.algonode.cloud/*",
    "https://*.baanx.com/*",
    "https://*.bidali.com/*",
    "https://firebaseremoteconfig.googleapis.com/*",
    "https://firebaseinstallations.googleapis.com/*",
    "https://www.google-analytics.com/*",
    "https://*.ingest.sentry.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; font-src 'self'"
  }
}
