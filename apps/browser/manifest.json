{
  "manifest_version": 3,
  "name": "Pera Wallet",
  "version": "0.1.0",
  "description": "Algorand wallet by Pera — browser extension (development build)",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pera Wallet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-inject-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-relay-isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://discover-mobile.perawallet.app/*",
        "https://discover-mobile-staging.perawallet.app/*"
      ],
      "js": ["content-discover-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://discover-mobile.perawallet.app/*",
        "https://discover-mobile-staging.perawallet.app/*"
      ],
      "js": ["content-discover-relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "https://commerce.bidali.com/*",
        "https://commerce.staging.bidali.com/*",
        "https://giftcards.bidali.com/*",
        "https://giftcards.staging.bidali.com/*"
      ],
      "js": ["content-bidali-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://commerce.bidali.com/*",
        "https://commerce.staging.bidali.com/*",
        "https://giftcards.bidali.com/*",
        "https://giftcards.staging.bidali.com/*"
      ],
      "js": ["content-bidali-relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-webauthn-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-webauthn-relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "_comment_externally_connectable": "Chrome's default when this key is absent already blocks web pages but ALLOWS other extensions. No onMessageExternal/onConnectExternal listener exists, so nothing is reachable today — declaring an empty allowlist makes the closed posture explicit and keeps a future listener from silently inheriting an open door.",
  "externally_connectable": { "ids": [] },
  "_comment_unlimitedStorage": "Lifts the 10MB chrome.storage.local cap and exempts our storage from quota-manager eviction. Both matter: the TanStack Query cache is persisted into chrome.storage.local (see AppShell.web.tsx), and the sqlite database lives in OPFS, which is evictable by default. Note that ChromeKeyValueStorageService.setItem is fire-and-forget, so a quota rejection would be silent — this permission is what keeps us away from that edge, not a guarantee. Growth is still unbounded; LRU/retention is a follow-up.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "offscreen"],
  "host_permissions": [
    "https://*.perawallet.app/*",
    "https://*.algonode.cloud/*",
    "https://*.baanx.com/*",
    "https://*.bidali.com/*",
    "https://firebaseremoteconfig.googleapis.com/*",
    "https://firebaseinstallations.googleapis.com/*",
    "https://www.google-analytics.com/*",
    "https://*.ingest.sentry.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; font-src 'self'"
  }
}
