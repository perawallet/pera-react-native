{
  "extends": "@perawallet/wallet-core-devtools/tsconfig/vite.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ESNext", "DOM", "WebWorker"],
    "types": ["chrome", "node"],
    "paths": {
      "@perawallet/wallet-extension-vault-chrome/vault/autolock": [
        "../../extensions/vault-chrome/src/vault/autolock.ts"
      ],
      "@perawallet/wallet-extension-platform-chrome": [
        "../../extensions/platform-chrome/src/index.ts"
      ],
      "@perawallet/wallet-extension-platform-chrome/messaging": [
        "../../extensions/platform-chrome/src/messaging.ts"
      ],
      "@perawallet/wallet-core-browser-runtime": [
        "../../packages/browser-runtime/src/index.ts"
      ],
      "@providers/*": [
        "../mobile/src/providers/*"
      ]
    }
  },
  "include": ["src", "e2e"]
}
