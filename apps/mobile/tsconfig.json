{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [
      "vitest",
      "vitest/globals"
    ],
    "paths": {
      "@components/*": [
        "./src/components/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@routes/*": [
        "./src/routes/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@i18n/*": [
        "./src/i18n/*"
      ],
      "@analytics": [
        "./src/analytics"
      ],
      "@analytics/*": [
        "./src/analytics/*"
      ],
      "@constants/*": [
        "./src/constants/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@assets/*": [
        "./assets/*"
      ],
      "@theme/*": [
        "./src/theme/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@test-utils/*": [
        "./src/test-utils/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@perawallet/wallet-core-card/test-handlers": [
        "../../packages/card/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-currencies/test-handlers": [
        "../../packages/currencies/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-assets/test-handlers": [
        "../../packages/assets/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-swaps/test-handlers": [
        "../../packages/swaps/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-messages/test-handlers": [
        "../../packages/messages/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-multisig/test-handlers": [
        "../../packages/multisig/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-staking/test-handlers": [
        "../../packages/staking/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-shared/test-handlers": [
        "../../packages/shared/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-shared/test-utils": [
        "../../packages/shared/src/test-utils/index.ts"
      ],
      "@perawallet/wallet-core-accounts/test-handlers": [
        "../../packages/accounts/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-transactions/test-handlers": [
        "../../packages/transactions/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-polling/test-handlers": [
        "../../packages/polling/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-device/test-handlers": [
        "../../packages/device/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-blockchain/test-handlers": [
        "../../packages/blockchain/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-banners/test-handlers": [
        "../../packages/banners/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-onramp/test-handlers": [
        "../../packages/onramp/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-nfd/test-handlers": [
        "../../packages/nfd/src/test-handlers.ts"
      ],
      // bare-package path pulls the full keystore graph into tsc; web code above the App.web boundary must import '@perawallet/wallet-extension-keystore-chrome/bootstrap' only (Metro enforces at runtime; tsc does not).
      "@perawallet/wallet-extension-keystore-chrome": [
        "../../extensions/keystore-chrome/src/index.ts"
      ],
      "@perawallet/wallet-extension-keystore-chrome/bootstrap": [
        "../../extensions/keystore-chrome/src/bootstrap.ts"
      ],
      // bare-package path pulls the full platform-chrome graph (drizzle-orm,
      // hardware-wallet registry) into tsc; web code above the App.web
      // boundary must import '@perawallet/wallet-extension-platform-chrome/bootstrap'
      // only (Metro enforces at runtime; tsc does not).
      "@perawallet/wallet-extension-platform-chrome": [
        "../../extensions/platform-chrome/src/index.ts"
      ],
      "@perawallet/wallet-extension-platform-chrome/bootstrap": [
        "../../extensions/platform-chrome/src/bootstrap.ts"
      ],
      "@perawallet/wallet-extension-platform-driver": [
        "../../extensions/platform-driver/src/index.ts"
      ]
    },
    "lib": [
      "esnext",
      "dom"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.svg",
    "**/*.png"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "**/coverage"
  ]
}
