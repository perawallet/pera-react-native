{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [
      "vitest",
      "vitest/globals"
    ],
    "paths": {
      "@components/*": [
        "./src/components/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@routes/*": [
        "./src/routes/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@constants/*": [
        "./src/constants/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@assets/*": [
        "./assets/*"
      ],
      "@theme/*": [
        "./src/theme/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@test-utils/*": [
        "./src/test-utils/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@perawallet/wallet-core-currencies/test-handlers": [
        "../../packages/currencies/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-assets/test-handlers": [
        "../../packages/assets/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-swaps/test-handlers": [
        "../../packages/swaps/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-messages/test-handlers": [
        "../../packages/messages/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-staking/test-handlers": [
        "../../packages/staking/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-shared/test-handlers": [
        "../../packages/shared/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-accounts/test-handlers": [
        "../../packages/accounts/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-transactions/test-handlers": [
        "../../packages/transactions/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-polling/test-handlers": [
        "../../packages/polling/src/test-handlers.ts"
      ],
      "@perawallet/wallet-core-device/test-handlers": [
        "../../packages/device/src/test-handlers.ts"
      ]
    },
    "lib": [
      "esnext",
      "dom"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.svg",
    "**/*.png"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "**/coverage"
  ]
}
