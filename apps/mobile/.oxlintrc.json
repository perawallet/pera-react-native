{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/lib/**",
    "**/.turbo/**",
    "android/**",
    "ios/**",
    "**/src/test-utils/**",
    "**/*.generated.ts"
  ],
  "plugins": ["typescript", "unicorn", "react", "import"],
  "jsPlugins": [
    "eslint-plugin-unused-imports",
    "eslint-plugin-react-native",
    "@perawallet/wallet-core-devtools/oxlint"
  ],
  "globals": {
    "__DEV__": "readonly",
    "__dirname": "readonly",
    "__filename": "readonly"
  },
  "rules": {
    "react/display-name": "off",
    "react/jsx-key": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/no-string-refs": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "error",
    "react/react-in-jsx-scope": "off",
    "react-native/no-unused-styles": "error",
    "react-native/split-platform-components": "error",
    "react-native/no-inline-styles": "error",
    "react-native/no-color-literals": "error",
    "react-native/no-single-element-style-arrays": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "no-console": "warn",
    "no-unused-vars": "off",
    "prefer-const": "error",
    "no-var": "error",
    "import/no-duplicates": ["error", { "prefer-inline": true }],
    "unused-imports/no-unused-imports": "error",
    "pera/no-unvalidated-open-url": "error",
    "max-lines": [
      "warn",
      {
        "max": 300,
        "skipBlankLines": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.spec.{ts,tsx,js,jsx}",
        "**/__tests__/**/*.{ts,tsx,js,jsx}"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "pera/no-platform-os-web": "error",
        "no-restricted-globals": [
          "error",
          {
            "name": "chrome",
            "message": "apps/mobile must not reference the ambient chrome global directly — go through a chrome-owning package (e.g. @perawallet/wallet-extension-platform-chrome, @perawallet/wallet-core-browser-runtime, @perawallet/wallet-extension-keystore-chrome) or its typed accessor instead."
          },
          {
            "name": "fetch",
            "message": "Request through queryClient from @perawallet/wallet-core-shared, which carries the retries, timeouts and typed errors a raw fetch skips. A call that must use fetch itself (another host's client, platform code with no client) takes an oxlint-disable-next-line comment giving its reason."
          }
        ]
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "excludeFiles": [
        "src/modules/settings/screens/developer/**",
        "src/**/__tests__/**",
        "src/**/__mocks__/**",
        "src/**/__integration__/**",
        "src/**/*.{spec,test}.{ts,tsx}",
        "src/**/*.d.ts"
      ],
      "rules": {
        "pera/no-hardcoded-ui-strings": "error"
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "excludeFiles": ["src/**/__tests__/**"],
      "rules": {
        "pera/dev-gallery-entry-points": "error"
      }
    },
    {
      "files": ["src/**"],
      "excludeFiles": [
        "src/**/__tests__/**",
        "src/**/__mocks__/**",
        "src/**/test-utils/**",
        "src/**/__integration__/**",
        "src/**/*.spec.{ts,tsx}",
        "src/**/*.test.{ts,tsx}"
      ],
      "rules": {
        "pera/wc-connector-ownership": "error"
      }
    },
    {
      "files": ["src/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/__mocks__/**", "src/**/test-utils/**", "src/**/__integration__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}", "src/modules/settings/screens/developer/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "StyleSheet",
            "property": "create",
            "message": "Style with makeStyles from @rneui/themed, in a styles.ts beside the component."
          },
          {
            "object": "Alert",
            "property": "alert",
            "message": "Show a bottom sheet, or the error toast for failures; only developer screens use a native alert."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Request through queryClient from @perawallet/wallet-core-shared, which carries the retries, timeouts and typed errors a raw fetch skips. A call that must use fetch itself (another host's client, platform code with no client) takes an oxlint-disable-next-line comment giving its reason."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "Request through queryClient from @perawallet/wallet-core-shared, which carries the retries, timeouts and typed errors a raw fetch skips. A call that must use fetch itself (another host's client, platform code with no client) takes an oxlint-disable-next-line comment giving its reason."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "Request through queryClient from @perawallet/wallet-core-shared, which carries the retries, timeouts and typed errors a raw fetch skips. A call that must use fetch itself (another host's client, platform code with no client) takes an oxlint-disable-next-line comment giving its reason."
          }
        ]
      }
    },
    {
      "files": ["src/modules/settings/screens/developer/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "StyleSheet",
            "property": "create",
            "message": "Style with makeStyles from @rneui/themed, in a styles.ts beside the component."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Request through queryClient from @perawallet/wallet-core-shared, which carries the retries, timeouts and typed errors a raw fetch skips. A call that must use fetch itself (another host's client, platform code with no client) takes an oxlint-disable-next-line comment giving its reason."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "Request through queryClient from @perawallet/wallet-core-shared, which carries the retries, timeouts and typed errors a raw fetch skips. A call that must use fetch itself (another host's client, platform code with no client) takes an oxlint-disable-next-line comment giving its reason."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "Request through queryClient from @perawallet/wallet-core-shared, which carries the retries, timeouts and typed errors a raw fetch skips. A call that must use fetch itself (another host's client, platform code with no client) takes an oxlint-disable-next-line comment giving its reason."
          }
        ]
      }
    },
    {
      "files": ["src/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/__mocks__/**", "src/**/test-utils/**", "src/**/__integration__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "zustand/middleware",
                "importNames": ["persist", "createJSONStorage"],
                "message": "Persist through guardedPersist from @perawallet/wallet-core-shared, which quarantines state it cannot restore instead of letting the next write erase it."
              },
              {
                "name": "decimal.js",
                "importNames": ["default"],
                "message": "Import the named { Decimal } from decimal.js."
              },
              {
                "name": "react-native",
                "importNames": ["ActivityIndicator"],
                "message": "Use PWLoadingIndicator from @components/core."
              }
            ]
          }
        ],
        "pera/decimal-construction": "error"
      }
    },
    {
      "files": ["src/modules/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/__mocks__/**", "src/**/test-utils/**", "src/**/__integration__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "zustand/middleware",
                "importNames": ["persist", "createJSONStorage"],
                "message": "Persist through guardedPersist from @perawallet/wallet-core-shared, which quarantines state it cannot restore instead of letting the next write erase it."
              },
              {
                "name": "decimal.js",
                "importNames": ["default"],
                "message": "Import the named { Decimal } from decimal.js."
              },
              {
                "name": "react-native",
                "importNames": ["ActivityIndicator"],
                "message": "Use PWLoadingIndicator from @components/core."
              },
              {
                "name": "@tanstack/react-query",
                "importNames": ["useQuery", "useQueries", "useInfiniteQuery", "useSuspenseQuery", "useSuspenseQueries", "useSuspenseInfiniteQuery", "useMutation"],
                "message": "Put this query or mutation in its domain package as a named use…Query/use…Mutation hook with a declared result type, and call that hook here. useQueryClient stays allowed."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/__mocks__/**", "src/**/test-utils/**", "src/**/__integration__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "rules": { "pera/no-manual-unit-conversion": "error" }
    },
    {
      "files": ["src/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/__mocks__/**", "src/**/test-utils/**", "src/**/__integration__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "rules": { "pera/no-display-string-identity": "error", "pera/fetch-has-deadline": "error" }
    },
    {
      "files": ["src/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/__mocks__/**", "src/**/test-utils/**", "src/**/__integration__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}", "src/**/*.d.ts"],
      "rules": { "import/no-default-export": "error" }
    },
    {
      "files": [
        "src/modules/*/index.ts",
        "src/modules/*/routes/index.ts",
        "src/modules/*/routes/index.tsx",
        "src/modules/*/shell.ts",
        "src/modules/*/web.ts"
      ],
      "rules": { "pera/module-entry-named-exports": "error" }
    },
    {
      "files": ["src/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/__mocks__/**", "src/**/test-utils/**", "src/**/__integration__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "rules": { "pera/hook-result-type": "error" }
    },
    {
      "files": ["src/modules/**", "src/components/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/__mocks__/**", "src/**/test-utils/**", "src/**/__integration__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "rules": { "pera/no-package-store-internals": "error" }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "excludeFiles": ["src/components/core/**"],
      "rules": { "pera/test-id-prop": "error" }
    },
    {
      "files": ["src/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/**/__mocks__/**", "src/**/test-utils/**", "src/**/__integration__/**", "src/**/*.spec.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "rules": { "pera/prefer-to-error": "error" }
    },
    {
      "files": ["src/**/__tests__/**", "src/**/*.spec.{ts,tsx}", "src/**/__integration__/**", "src/**/test-utils/**", "vitest*.ts"],
      "rules": { "pera/no-algorand-sdk-imports": "off" }
    }
  ]
}
