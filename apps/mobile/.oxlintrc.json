{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/lib/**",
    "**/.turbo/**",
    "android/**",
    "ios/**",
    "**/src/test-utils/**",
    "**/*.generated.ts"
  ],
  "plugins": ["typescript", "unicorn", "react", "import"],
  "jsPlugins": ["eslint-plugin-unused-imports", "eslint-plugin-react-native"],
  "globals": {
    "__DEV__": "readonly",
    "__dirname": "readonly",
    "__filename": "readonly"
  },
  "rules": {
    "react/display-name": "off",
    "react/jsx-key": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/no-string-refs": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "error",
    "react/react-in-jsx-scope": "off",
    "react-native/no-unused-styles": "error",
    "react-native/split-platform-components": "error",
    "react-native/no-inline-styles": "error",
    "react-native/no-color-literals": "error",
    "react-native/no-single-element-style-arrays": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "no-console": "warn",
    "no-unused-vars": "off",
    "prefer-const": "error",
    "no-var": "error",
    "import/no-duplicates": ["error", { "prefer-inline": true }],
    "unused-imports/no-unused-imports": "error",
    "max-lines": [
      "warn",
      {
        "max": 300,
        "skipBlankLines": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.{ts,tsx,js,jsx}",
        "**/*.spec.{ts,tsx,js,jsx}",
        "**/__tests__/**/*.{ts,tsx,js,jsx}"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "chrome",
            "message": "apps/mobile must not reference the ambient chrome global directly — go through an extension package (e.g. @perawallet/wallet-extension-platform-chrome, @perawallet/wallet-extension-keystore-chrome) or its typed accessor instead."
          }
        ]
      }
    }
  ]
}
