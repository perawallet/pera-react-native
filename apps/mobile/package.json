{
  "name": "mobile",
  "version": "7.1.1-alpha",
  "versionCodeBase": 10000,
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "expo:prebuild": "expo prebuild --no-install --no-clean && node scripts/fix-development-team.js && pnpm dlx pod-install@1.2.1 ios",
    "expo:prebuild:clean": "expo prebuild --no-install && node scripts/fix-development-team.js && pnpm dlx pod-install@1.2.1 ios",
    "verify:ios-identity": "node scripts/verify-ios-identity.mjs",
    "verify:android-identity": "node scripts/verify-android-identity.mjs",
    "generate:production-icons": "node scripts/generate-production-icons.mjs",
    "locale-tour": "node scripts/locale-tour.mjs",
    "ios:fix-development-team": "node scripts/fix-development-team.js",
    "lint": "oxlint --config .oxlintrc.json .",
    "test": "bash ../../tools/dev/rebuild-native.sh && vitest run",
    "test:unit": "bash ../../tools/dev/rebuild-native.sh && vitest run --project unit --project unit-forks",
    "test:coverage": "bash ../../tools/dev/rebuild-native.sh && vitest run --coverage",
    "test:integration": "bash ../../tools/dev/rebuild-native.sh && vitest run --project=integration",
    "test:integration:watch": "bash ../../tools/dev/rebuild-native.sh && vitest --project=integration",
    "test:watch": "bash ../../tools/dev/rebuild-native.sh && vitest",
    "build:ios:dev": "APP_ENV=development expo run:ios --configuration Debug",
    "build:ios:staging": "APP_ENV=staging DEFAULT_NETWORK=testnet expo run:ios --configuration Release",
    "build:ios:production": "APP_ENV=production expo run:ios --configuration Release",
    "build:android:dev": "APP_ENV=development expo run:android --variant devDebug",
    "build:android:staging": "APP_ENV=staging DEFAULT_NETWORK=testnet cd android && ./gradlew assembleStagingRelease",
    "build:android:production": "APP_ENV=production cd android && ./gradlew assembleProductionRelease",
    "fastlane:ios:staging": "DEFAULT_NETWORK=testnet bundle exec fastlane ios build_staging",
    "fastlane:ios:production": "bundle exec fastlane ios build_production",
    "fastlane:android:staging": "DEFAULT_NETWORK=testnet bundle exec fastlane android build_staging",
    "fastlane:android:production": "bundle exec fastlane android build_production",
    "bench:ios": "BENCH=1 APP_ENV=development expo prebuild --no-install && node scripts/fix-development-team.js && pnpm dlx pod-install@1.2.1 ios && BENCH=1 APP_ENV=development expo run:ios --configuration Release --device",
    "bench:android": "BENCH=1 APP_ENV=development expo prebuild --no-install && cd android && BENCH=1 APP_ENV=development ./gradlew installRelease",
    "build": "tsc --noEmit"
  },
