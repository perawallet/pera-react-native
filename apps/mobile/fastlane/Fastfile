# Fastfile for Pera Wallet React Native App
#
# This Fastfile contains lanes for building iOS and Android versions
# of Pera Wallet across different environments (dev, staging, production)

# Helper to get version from package.json (strips suffixes like -alpha)
def get_package_version
  require 'json'
  package_data = JSON.parse(File.read("../package.json"))
  package_data["version"].split("-").first
end

# Helper to read the committed version-code base (PERA-4451). Added to the CI
# BUILD_NUMBER to floor the iOS build number / Android versionCode above the
# live store values. Mirrors app.config.builder.js's resolveBuildNumber.
def get_version_code_base
  require 'json'
  package_data = JSON.parse(File.read("../package.json"))
  Integer(package_data.fetch("versionCodeBase"))
end

# Final build identifier = base + monotonic CI BUILD_NUMBER (0 when unset).
def resolve_build_number
  get_version_code_base + ENV['BUILD_NUMBER'].to_i
end

# Helper to find the dynamic xcodeproj path (generated by Expo)
def get_xcodeproj_path
  # Debug paths
  puts "Current Directory: #{Dir.pwd}"
  
  # Try standard location
  project = Dir["./ios/*.xcodeproj"].first
  return File.expand_path(project) if project

  # Try fallback relative to fastlane folder
  project = Dir["../ios/*.xcodeproj"].first
  return File.expand_path(project) if project

  raise "Could not find any .xcodeproj file in ./ios/ or ../ios/. CWD: #{Dir.pwd}. Files: #{Dir['*']}"
end

# Helper to find the dynamic xcworkspace path
def get_xcworkspace_path
  # Try standard location
  workspace = Dir["./ios/*.xcworkspace"].first
  return File.expand_path(workspace) if workspace

  # Try fallback relative to fastlane folder
  workspace = Dir["../ios/*.xcworkspace"].first
  return File.expand_path(workspace) if workspace

  raise "Could not find any .xcworkspace file. CWD: #{Dir.pwd}"
end

default_platform(:ios)

# ============================================================================
# iOS Platform
# ============================================================================

platform :ios do
  before_all do
    if is_ci
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
        duration: 1200,
        in_house: false
      )
    end
  end

  desc "Build iOS Staging"
  lane :build_staging do
    build_ios(
      scheme: "Pera7Staging",
      configuration: "Release",
      export_method: "ad-hoc",
      clean: false
    )
  end

  desc "Build iOS Production"
  lane :build_production do
    build_ios(
      scheme: "Pera7Production",
      configuration: "Release",
      export_method: "app-store"
    )
  end

  desc "Build iOS for specific scheme"
  private_lane :build_ios do |options|
    clean = options[:clean]
    clean = true if clean.nil?

    # Inject version from package.json
    version = get_package_version
    increment_version_number(
      version_number: version,
      xcodeproj: get_xcodeproj_path
    )

    # Always floor to the base (+ CI counter). Unconditional so even a build
    # without BUILD_NUMBER ships the base, never the prebuild placeholder.
    increment_build_number(
      build_number: resolve_build_number.to_s,
      xcodeproj: get_xcodeproj_path
    )

    # Determine Bundle ID for export options
    bundle_id = case options[:scheme]
    when "Pera7Production" then "com.algorandllc.perarn"
    else "com.algorandllc.perarn.staging"
    end
    # AutoFill credential-provider extension (added by the passkey plugin).
    extension_bundle_id = "#{bundle_id}.PasskeyAutofillCredentialProvider"

    app_profile = ENV["IOS_PROVISIONING_PROFILE_NAME"]
    extension_profile = ENV["IOS_AUTOFILL_PROVISIONING_PROFILE_NAME"]

    export_options = {}
    xcargs_list = ["CODE_SIGN_STYLE='Manual'"]

    if app_profile
      # Per-target profiles: a single global PROVISIONING_PROFILE_SPECIFIER
      # xcarg would force the app profile onto the extension, so pin each
      # target to its own profile on the project, then map both for export.
      update_code_signing_settings(
        path: get_xcodeproj_path,
        use_automatic_signing: false,
        team_id: ENV["IOS_TEAM_ID"],
        code_sign_identity: "Apple Distribution",
        targets: [options[:scheme]],
        profile_name: app_profile
      )
      export_options[:provisioningProfiles] = { bundle_id => app_profile }

      if extension_profile
        update_code_signing_settings(
          path: get_xcodeproj_path,
          use_automatic_signing: false,
          team_id: ENV["IOS_TEAM_ID"],
          code_sign_identity: "Apple Distribution",
          targets: ["PasskeyAutofillCredentialProvider"],
          profile_name: extension_profile
        )
        export_options[:provisioningProfiles][extension_bundle_id] = extension_profile
      else
        UI.important("IOS_AUTOFILL_PROVISIONING_PROFILE_NAME not set — the AutoFill extension target won't be signed and the archive will fail.")
      end

      xcargs_list << "CODE_SIGN_IDENTITY='Apple Distribution'"
    end

    # `$(DEVELOPMENT_TEAM)` on the extension target resolves from this.
    xcargs_list << "DEVELOPMENT_TEAM='#{ENV["IOS_TEAM_ID"]}'" if ENV["IOS_TEAM_ID"]

    gym(
      scheme: options[:scheme],
      configuration: options[:configuration],
      export_method: options[:export_method],
      workspace: get_xcworkspace_path,
      output_directory: "./build/ios",
      output_name: "#{options[:scheme]}.ipa",
      clean: clean,
      export_options: export_options,
      xcargs: xcargs_list.join(" ")
    )
  end


  desc "Deploy to TestFlight"
  lane :deploy_testflight do |options|
    scheme = options[:scheme] || "Pera7Staging"

    # Map scheme to configuration
    configuration = case scheme
    when "Pera7Staging" then "Staging"
    when "Pera7Production" then "Production"
    when "Pera-Dev" then "Dev"
    else "Staging"
    end

    clean = options[:clean]
    clean = true if clean.nil?

    build_ios(
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store",
      clean: clean
    )

    upload_symbols_to_crashlytics(
      gsp_path: "./config/GoogleService-Info.plist",
      dsym_path: "./build/ios/#{scheme}.app.dSYM.zip",
      binary_path: "./ios/Pods/FirebaseCrashlytics/upload-symbols"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "./build/ios/#{scheme}.ipa"
    )
  end

  desc "Increment build number"
  lane :bump_build do
    increment_build_number(
      xcodeproj: get_xcodeproj_path
    )
  end

  desc "Increment version number"
  lane :bump_version do |options|
    increment_version_number(
      xcodeproj: get_xcodeproj_path,
      bump_type: options[:bump_type] || "patch"
    )
  end
end

# ============================================================================
# Android Platform
# ============================================================================

platform :android do
  desc "Build Android Staging"
  lane :build_staging do
    build_android(
      flavor: "staging",
      build_type: "Release"
    )
  end

  desc "Build Android Production"
  lane :build_production do
    build_android(
      flavor: "production",
      build_type: "Release"
    )
  end

  desc "Build Android for specific flavor and build type"
  # Options:
  #   flavor: "staging" | "production"
  #   build_type: "Release" | "Debug"
  #   clean: true | false (default: true)
  #   artifact_type: "aab" | "apk" (default: "aab")
  private_lane :build_android do |options|
    clean = options[:clean].nil? ? true : options[:clean]
    artifact_type = options[:artifact_type] || "aab"

    version = get_package_version
    gradle_task = artifact_type == "apk" ? "assemble" : "bundle"
    task = clean ? "clean #{gradle_task}" : gradle_task

    gradle(
      task: task,
      # flavor: options[:flavor], # Standard Expo Prebuild projects don't use flavors
      build_type: options[:build_type],
      project_dir: "android/",
      properties: {
        "android.injected.version.code" => resolve_build_number,
        "android.injected.version.name" => version
      }
    )
  end

  # Returns the artifact path for a given flavor and type
  def android_artifact_path(flavor, artifact_type)
    if artifact_type == "apk"
      "android/app/build/outputs/apk/release/app-release.apk"
    else
      "android/app/build/outputs/bundle/release/app-release.aab"
    end
  end

  desc "Build and publish to Play Store"
  lane :deploy_internal do |options|
    flavor = options[:flavor] || "staging"
    clean = options[:clean].nil? ? true : options[:clean]

    # TODO: Switch back to "aab" once Play Store deployment is enabled
    build_android(
      flavor: flavor,
      build_type: "Release",
      clean: clean,
      artifact_type: "apk"
    )

    package_name = flavor == "production" ? "com.algorand.perarn" : "com.algorand.perarn.staging"

    # upload_to_play_store(
    #   track: "internal",
    #   package_name: package_name,
    #   aab: android_artifact_path(flavor, "aab"),
    #   version_code: ENV["BUILD_NUMBER"],
    #   skip_upload_metadata: true,
    #   skip_upload_images: true,
    #   skip_upload_screenshots: true,
    #   json_key: "config/api-key.json"
    # )

    # We are deploying production builds to Firebase for the purpose of testing also
    # Unescape literal \n to real newlines for Firebase release notes
    notes = unescape_changelog(ENV["RELEASE_NOTES"] || "Build #{ENV['BUILD_NUMBER'] || 'dev'}")

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"]&.strip,
      groups: "pera,pera-alpha",
      release_notes: notes,
      android_artifact_type: "APK",
      android_artifact_path: android_artifact_path(flavor, "apk"),
      service_credentials_file: "config/firebase-service-account.json"
    )
  end

  desc "Build and publish to Firebase App Distribution (for QA)"
  lane :deploy_firebase do |options|
    flavor = options[:flavor] || "staging"
    clean = options[:clean].nil? ? true : options[:clean]

    build_android(
      flavor: flavor,
      build_type: "Release",
      clean: clean,
      artifact_type: "apk"
    )

    # Unescape literal \n to real newlines for Firebase release notes
    notes = unescape_changelog(ENV["RELEASE_NOTES"] || "Build #{ENV['BUILD_NUMBER'] || 'dev'}")

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"]&.strip,
      groups: (ENV["FIREBASE_TESTER_GROUPS"] || "qa-testers").strip,
      release_notes: notes,
      android_artifact_type: "APK",
      android_artifact_path: android_artifact_path(flavor, "apk"),
      service_credentials_file: "config/firebase-service-account.json"
    )
  end

  desc "Increment version code"
  lane :bump_version_code do
    increment_version_code(
      gradle_file_path: "android/app/build.gradle"
    )
  end

  desc "Increment version name"
  lane :bump_version_name do |options|
    increment_version_name(
      gradle_file_path: "android/app/build.gradle",
      bump_type: options[:bump_type] || "patch"
    )
  end
end

# ============================================================================
# Helper Functions
# ============================================================================

# Check if running in CI environment
def is_ci
  ENV['CI'] == 'true' || ENV['GITHUB_ACTIONS'] == 'true'
end

# Unescape literal \n sequences to real newlines for upload changelogs.
# The changelog is double-escaped for Slack JSON compatibility, but
# Firebase and TestFlight need real newlines.
def unescape_changelog(text)
  text.strip.gsub('\\n', "\n")
end
