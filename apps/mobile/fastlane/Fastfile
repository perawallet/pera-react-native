# Fastfile for Pera Wallet React Native App
#
# This Fastfile contains lanes for building iOS and Android versions
# of Pera Wallet across different environments (dev, staging, production)

# Helper to get version from package.json (strips suffixes like -alpha)
def get_package_version
  require 'json'
  package_data = JSON.parse(File.read("../package.json"))
  package_data["version"].split("-").first
end

# Marketing version (CFBundleShortVersionString / versionName). The git tag is
# the source of truth on CI — the bitrise version step derives APP_VERSION from
# it (tag base, e.g. v7.0.1-alpha.3 -> 7.0.1). Falls back to package.json for
# local/manual runs where APP_VERSION isn't set.
def resolve_marketing_version
  env = ENV["APP_VERSION"]
  (env && !env.empty?) ? env : get_package_version
end

# Helper to read the committed version-code base (PERA-4451). Added to the CI
# BUILD_NUMBER to floor the iOS build number / Android versionCode above the
# live store values. Mirrors app.config.builder.js's resolveBuildNumber.
def get_version_code_base
  require 'json'
  package_data = JSON.parse(File.read("../package.json"))
  Integer(package_data.fetch("versionCodeBase"))
end

# Final build identifier = base + monotonic CI BUILD_NUMBER (0 when unset).
def resolve_build_number
  get_version_code_base + ENV['BUILD_NUMBER'].to_i
end

# Helper to find the dynamic xcodeproj path (generated by Expo)
def get_xcodeproj_path
  # Debug paths
  puts "Current Directory: #{Dir.pwd}"
  
  # Try standard location
  project = Dir["./ios/*.xcodeproj"].first
  return File.expand_path(project) if project

  # Try fallback relative to fastlane folder
  project = Dir["../ios/*.xcodeproj"].first
  return File.expand_path(project) if project

  raise "Could not find any .xcodeproj file in ./ios/ or ../ios/. CWD: #{Dir.pwd}. Files: #{Dir['*']}"
end

# Helper to find the dynamic xcworkspace path
def get_xcworkspace_path
  # Try standard location
  workspace = Dir["./ios/*.xcworkspace"].first
  return File.expand_path(workspace) if workspace

  # Try fallback relative to fastlane folder
  workspace = Dir["../ios/*.xcworkspace"].first
  return File.expand_path(workspace) if workspace

  raise "Could not find any .xcworkspace file. CWD: #{Dir.pwd}"
end

# App and AutoFill extension bundle ids, which must match app.config.builder.js.
# Production's extension is renamed to the legacy native id by
# withAutofillExtensionBundleId.js so iOS keeps the user's password-manager
# selection across the native→RN upgrade; staging/dev keep the passkey
# plugin's default. Each id needs its own provisioning profile.
def ios_bundle_ids(scheme)
  production = scheme == "PeraAlgoWallet"
  app = production ? "com.algorandllc.algorand" : "com.algorandllc.perarn.staging"
  [app, app + (production ? ".autofill-extension" : ".PasskeyAutofillCredentialProvider")]
end

# The ad-hoc profile names, service credentials file, app id and tester groups
# the Firebase export needs, raising on whichever is missing, so a
# misconfiguration fails before the build rather than after TestFlight
# accepted it.
def ios_firebase_settings
  app_profile = ENV["IOS_FIREBASE_PROVISIONING_PROFILE_NAME"].to_s.strip
  extension_profile = ENV["IOS_FIREBASE_AUTOFILL_PROVISIONING_PROFILE_NAME"].to_s.strip
  credentials = ENV["FIREBASE_IOS_SERVICE_CREDENTIALS_FILE"].to_s
  UI.user_error!("Firebase needs separate ad-hoc profiles for the app and AutoFill extension") if app_profile.empty? || extension_profile.empty?
  UI.user_error!("Firebase service credentials were not prepared by the iOS job") unless File.file?(credentials)
  UI.user_error!("Firebase service credentials are not a service-account key") unless service_account_key?(credentials)
  # Tester groups belong to each Firebase app, so the Android lanes' alias may not exist here.
  groups = ENV["FIREBASE_TESTER_GROUPS"].to_s.strip
  UI.user_error!("Firebase needs FIREBASE_TESTER_GROUPS naming groups of the iOS app") if groups.empty?

  # Read the environment-selected config explicitly so CI never prompts to
  # choose an app or relies on an archive's default plist location.
  app_id = ENV["FIREBASE_APP_ID_IOS"].to_s.strip
  if app_id.empty?
    app_id = get_info_plist_value(path: "./config/GoogleService-Info.plist", key: "GOOGLE_APP_ID").to_s.strip
  end
  UI.user_error!("Firebase needs the selected environment's iOS GOOGLE_APP_ID") unless app_id.match?(/\A1:\d+:ios:[0-9a-f]+\z/)

  [app_profile, extension_profile, credentials, app_id, groups]
end

def service_account_key?(path)
  require 'json'
  key = JSON.parse(File.read(path))
  key.is_a?(Hash) && !key["client_email"].to_s.empty? && !key["project_id"].to_s.empty?
rescue JSON::ParserError
  false
end

# Firebase Apple 13 ships only as Swift packages, so Crashlytics' upload tool
# sits in the package checkout under the workspace's DerivedData, not in Pods/.
def get_crashlytics_upload_symbols_path
  workspace = File.basename(get_xcworkspace_path, ".xcworkspace")
  pattern = File.expand_path(
    "~/Library/Developer/Xcode/DerivedData/#{workspace}-*/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"
  )
  path = Dir[pattern].max_by { |candidate| File.mtime(candidate) }
  return path if path

  raise "Could not find Crashlytics upload-symbols at #{pattern}"
end

default_platform(:ios)

# ============================================================================
# iOS Platform
# ============================================================================

platform :ios do
  before_all do
    if is_ci
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
        duration: 1200,
        in_house: false
      )
    end
  end

  desc "Build iOS Staging"
  lane :build_staging do
    build_ios(
      scheme: "Pera7Staging",
      configuration: "Release",
      export_method: "ad-hoc",
      clean: false
    )
  end

  desc "Build iOS Production"
  lane :build_production do
    build_ios(
      scheme: "Pera7Production",
      configuration: "Release",
      export_method: "app-store"
    )
  end

  desc "Build iOS for specific scheme"
  private_lane :build_ios do |options|
    clean = options[:clean]
    clean = true if clean.nil?

    # Inject version from package.json
    version = resolve_marketing_version
    increment_version_number(
      version_number: version,
      xcodeproj: get_xcodeproj_path
    )

    # Always floor to the base (+ CI counter). Unconditional so even a build
    # without BUILD_NUMBER ships the base, never the prebuild placeholder.
    increment_build_number(
      build_number: resolve_build_number.to_s,
      xcodeproj: get_xcodeproj_path
    )

    bundle_id, extension_bundle_id = ios_bundle_ids(options[:scheme])

    app_profile = ENV["IOS_PROVISIONING_PROFILE_NAME"]
    extension_profile = ENV["IOS_AUTOFILL_PROVISIONING_PROFILE_NAME"]

    export_options = {}
    xcargs_list = ["CODE_SIGN_STYLE='Manual'"]

    if app_profile
      # Per-target profiles: a single global PROVISIONING_PROFILE_SPECIFIER
      # xcarg would force the app profile onto the extension, so pin each
      # target to its own profile on the project, then map both for export.
      update_code_signing_settings(
        path: get_xcodeproj_path,
        use_automatic_signing: false,
        team_id: ENV["IOS_TEAM_ID"],
        code_sign_identity: "Apple Distribution",
        targets: [options[:scheme]],
        profile_name: app_profile
      )
      export_options[:provisioningProfiles] = { bundle_id => app_profile }

      if extension_profile
        update_code_signing_settings(
          path: get_xcodeproj_path,
          use_automatic_signing: false,
          team_id: ENV["IOS_TEAM_ID"],
          code_sign_identity: "Apple Distribution",
          targets: ["PasskeyAutofillCredentialProvider"],
          profile_name: extension_profile
        )
        export_options[:provisioningProfiles][extension_bundle_id] = extension_profile
      else
        UI.important("IOS_AUTOFILL_PROVISIONING_PROFILE_NAME not set — the AutoFill extension target won't be signed and the archive will fail.")
      end

      xcargs_list << "CODE_SIGN_IDENTITY='Apple Distribution'"
    end

    # `$(DEVELOPMENT_TEAM)` on the extension target resolves from this.
    xcargs_list << "DEVELOPMENT_TEAM='#{ENV["IOS_TEAM_ID"]}'" if ENV["IOS_TEAM_ID"]

    gym(
      scheme: options[:scheme],
      configuration: options[:configuration],
      export_method: options[:export_method],
      workspace: get_xcworkspace_path,
      output_directory: "./build/ios",
      output_name: "#{options[:scheme]}.ipa",
      clean: clean,
      export_options: export_options,
      xcargs: xcargs_list.join(" ")
    )
  end


  desc "Deploy to TestFlight"
  lane :deploy_testflight do |options|
    scheme = options[:scheme] || "Pera7Staging"

    clean = options[:clean]
    clean = true if clean.nil?

    # Before the build: found only at the export, a Firebase misconfiguration
    # fails a job whose build TestFlight has already accepted.
    ios_firebase_settings if options[:firebase].to_s == "true" && options[:skip_upload].to_s != "true"

    # The prebuilt project only has Debug and Release. An unknown name falls
    # back to Release for the projects but not for Swift packages, which then
    # build into <name>-iphoneos while the app copies their bundles from
    # Release-iphoneos, and the archive fails.
    build_ios(
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      clean: clean
    )

    # ci/jobs/ios.sh passes this while CI_UPLOADS_ENABLED is off: a signed IPA, nothing uploaded.
    next if options[:skip_upload].to_s == "true"

    # Upload every dSYM the archive produced — not only the app zip gym
    # exports — so React Native / Hermes-VM crash frames symbolicate too, not
    # just native ones. RN 0.86's prebuilt hermesvm.xcframework ships no dSYM
    # in the pod, so Hermes coverage depends entirely on what Xcode emitted
    # into the archive; the log line records exactly what was uploaded for
    # this build. Falls back to the app zip if the archive path is
    # unavailable, preserving the previous behavior.
    archive = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    archive_dsyms = archive ? Dir.glob(File.join(archive, "dSYMs", "*.dSYM")).sort : []

    crashlytics_options = {
      gsp_path: "./config/GoogleService-Info.plist",
      binary_path: get_crashlytics_upload_symbols_path
    }
    if archive_dsyms.any?
      UI.message(
        "Uploading dSYMs to Crashlytics: #{archive_dsyms.map { |path| File.basename(path) }.join(", ")}"
      )
      # `dsym_path` accepts one .dSYM bundle or one .zip — handing it the
      # archive's `dSYMs` *directory* fails the action's own validation with
      # "Symbolication file needs to be dSYM or zip", which failed every iOS
      # release build. The bundles have to go in individually via `dsym_paths`.
      crashlytics_options[:dsym_paths] = archive_dsyms
    else
      UI.important("Archive dSYMs dir not found — uploading the app dSYM zip only")
      crashlytics_options[:dsym_path] = "./build/ios/#{scheme}.app.dSYM.zip"
    end

    upload_symbols_to_crashlytics(crashlytics_options)

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "./build/ios/#{scheme}.ipa"
    )

    # Re-export the same archive for Firebase; App Store IPAs cannot be
    # installed directly by testers. Never replace the TestFlight IPA.
    distribute_firebase(scheme: scheme) if options[:firebase].to_s == "true"
  end

  desc "Export an existing iOS archive for Firebase App Distribution"
  private_lane :distribute_firebase do |options|
    scheme = options[:scheme] || "Pera7Staging"
    archive = options[:archive_path] || lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    UI.user_error!("Firebase needs the archive produced by the TestFlight build") unless archive && File.directory?(archive)
    app_profile, extension_profile, credentials, app_id, groups = ios_firebase_settings

    bundle_id, extension_id = ios_bundle_ids(scheme)
    # gym resolves a workspace and scheme even when only exporting, and the
    # workspace is under ./ios, out of its auto-detection's reach.
    ipa = gym(
      workspace: get_xcworkspace_path,
      scheme: scheme,
      skip_build_archive: true,
      archive_path: archive,
      export_method: "ad-hoc",
      output_directory: "./build/ios",
      output_name: "#{scheme}-firebase.ipa",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: ENV["IOS_TEAM_ID"],
        provisioningProfiles: { bundle_id => app_profile, extension_id => extension_profile }
      }
    )
    notes = unescape_changelog(ENV["RELEASE_NOTES"].to_s)
    notes = "Build #{ENV['BUILD_NUMBER'] || 'dev'}" if notes.empty?
    firebase_app_distribution(app: app_id, ipa_path: ipa, groups: groups, release_notes: notes, service_credentials_file: credentials)
  end

  desc "Increment build number"
  lane :bump_build do
    increment_build_number(
      xcodeproj: get_xcodeproj_path
    )
  end

  desc "Increment version number"
  lane :bump_version do |options|
    increment_version_number(
      xcodeproj: get_xcodeproj_path,
      bump_type: options[:bump_type] || "patch"
    )
  end
end

# ============================================================================
# Android Platform
# ============================================================================

platform :android do
  desc "Build Android Staging"
  lane :build_staging do
    build_android(
      flavor: "staging",
      build_type: "Release"
    )
  end

  desc "Build Android Production"
  lane :build_production do
    build_android(
      flavor: "production",
      build_type: "Release"
    )
  end

  desc "Build Android for specific flavor and build type"
  # Options:
  #   flavor: "staging" | "production"
  #   build_type: "Release" | "Debug"
  #   clean: true | false (default: true)
  #   artifact_type: "aab" | "apk" (default: "aab")
  private_lane :build_android do |options|
    clean = options[:clean].nil? ? true : options[:clean]
    artifact_type = options[:artifact_type] || "aab"

    version = resolve_marketing_version
    gradle_task = artifact_type == "apk" ? "assemble" : "bundle"
    task = clean ? "clean #{gradle_task}" : gradle_task

    gradle(
      task: task,
      # flavor: options[:flavor], # Standard Expo Prebuild projects don't use flavors
      build_type: options[:build_type],
      project_dir: "android/",
      properties: {
        "android.injected.version.code" => resolve_build_number,
        "android.injected.version.name" => version
      }
    )
  end

  # Resolve the publishing package from CI env so WB-1/WB-2 identity changes
  # flow through bitrise.yml's ANDROID_PACKAGE_NAME, not this file.
  def android_package_name(flavor)
    ENV["ANDROID_PACKAGE_NAME"] ||
      (flavor == "production" ? "com.algorand.android" : "com.algorand.perarn.staging")
  end

  # Checks the production identity on the project the build just produced, so a
  # wrong one fails before anything is uploaded.
  def verify_production_identity(package_name)
    return unless package_name == "com.algorand.android"
    sh("node", "../scripts/verify-android-identity.mjs", "--from-build")
  end

  # Returns the artifact path for a given flavor and type
  def android_artifact_path(flavor, artifact_type)
    if artifact_type == "apk"
      "android/app/build/outputs/apk/release/app-release.apk"
    else
      "android/app/build/outputs/bundle/release/app-release.aab"
    end
  end

  desc "Build AAB, upload to Play internal track, and distribute APK to Firebase"
  lane :deploy_internal do |options|
    flavor = options[:flavor] || "staging"
    clean = options[:clean].nil? ? true : options[:clean]

    package_name = android_package_name(flavor)

    # 1) Build the AAB and upload it to the Play internal track.
    build_android(
      flavor: flavor,
      build_type: "Release",
      clean: clean,
      artifact_type: "aab"
    )
    verify_production_identity(package_name)

    # Play's "What's new" for this build: pera-admin's summary of the release,
    # when the job has one. Never RELEASE_NOTES, whose full changelog runs past
    # Play's 500 characters and would fail the upload.
    play_notes = play_changelog_dir(unescape_changelog(ENV["CI_RELEASE_NOTES_SUMMARY"].to_s), resolve_build_number)

    upload_to_play_store(
      track: "internal",
      package_name: package_name,
      aab: android_artifact_path(flavor, "aab"),
      version_code: resolve_build_number,
      release_status: "completed",
      json_key: "config/api-key.json",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: play_notes.nil?,
      **(play_notes ? { metadata_path: play_notes } : {})
    )

    # 2) Also distribute an APK to Firebase App Distribution for dogfooding.
    #    clean:false so the AAB build above is not wiped.
    #
    #    Disable screen-capture prevention for THIS build only: the Firebase APK
    #    feeds BrowserStack, whose device mirroring can't drive a FLAG_SECURE
    #    surface. The Play AAB built above keeps protection on, so store users
    #    are unaffected. Scoped to the APK build and restored immediately after.
    previous_disable_capture = ENV["DISABLE_SCREEN_CAPTURE_PREVENTION"]
    ENV["DISABLE_SCREEN_CAPTURE_PREVENTION"] = "true"
    begin
      build_android(
        flavor: flavor,
        build_type: "Release",
        clean: false,
        artifact_type: "apk"
      )
    ensure
      ENV["DISABLE_SCREEN_CAPTURE_PREVENTION"] = previous_disable_capture
    end

    notes = unescape_changelog(ENV["RELEASE_NOTES"] || "Build #{ENV['BUILD_NUMBER'] || 'dev'}")

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"]&.strip,
      groups: "pera,pera-alpha",
      release_notes: notes,
      android_artifact_type: "APK",
      android_artifact_path: android_artifact_path(flavor, "apk"),
      service_credentials_file: "config/firebase-service-account.json"
    )
  end

  desc "Build and publish to Firebase App Distribution (for QA)"
  lane :deploy_firebase do |options|
    flavor = options[:flavor] || "staging"
    clean = options[:clean].nil? ? true : options[:clean]

    build_android(
      flavor: flavor,
      build_type: "Release",
      clean: clean,
      artifact_type: "apk"
    )
    verify_production_identity(android_package_name(flavor))

    # Unescape literal \n to real newlines for Firebase release notes
    notes = unescape_changelog(ENV["RELEASE_NOTES"] || "Build #{ENV['BUILD_NUMBER'] || 'dev'}")

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"]&.strip,
      groups: (ENV["FIREBASE_TESTER_GROUPS"] || "qa-testers").strip,
      release_notes: notes,
      android_artifact_type: "APK",
      android_artifact_path: android_artifact_path(flavor, "apk"),
      service_credentials_file: "config/firebase-service-account.json"
    )
  end

  desc "Increment version code"
  lane :bump_version_code do
    increment_version_code(
      gradle_file_path: "android/app/build.gradle"
    )
  end

  desc "Increment version name"
  lane :bump_version_name do |options|
    increment_version_name(
      gradle_file_path: "android/app/build.gradle",
      bump_type: options[:bump_type] || "patch"
    )
  end
end

# ============================================================================
# Helper Functions
# ============================================================================

# Check if running in CI environment
def is_ci
  ENV['CI'] == 'true' || ENV['GITHUB_ACTIONS'] == 'true'
end

PLAY_NOTES_MAX = 500

# A metadata folder holding only this build's en-US changelog, the shape
# upload_to_play_store reads release notes from; nil when there are no notes.
def play_changelog_dir(notes, version_code)
  text = notes.to_s.strip
  return nil if text.empty?

  require 'tmpdir'
  require 'fileutils'
  dir = File.join(Dir.mktmpdir("play-notes"), "en-US", "changelogs")
  FileUtils.mkdir_p(dir)
  UI.important("Play notes cut to #{PLAY_NOTES_MAX} characters (the summary has #{text.length})") if text.length > PLAY_NOTES_MAX
  File.write(File.join(dir, "#{version_code}.txt"), text[0, PLAY_NOTES_MAX])
  File.expand_path("../..", dir)
end

# Unescape literal \n sequences to real newlines for upload changelogs.
# The changelog is double-escaped for Slack JSON compatibility, but
# Firebase and TestFlight need real newlines.
def unescape_changelog(text)
  text.strip.gsub('\\n', "\n")
end
