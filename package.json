{
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash tools/setup.sh",
    "build": "bash tools/generate-config.sh && turbo run build",
    "build:packages": "bash tools/generate-config.sh && turbo run build --filter='./packages/*'",
    "dev": "turbo run dev",
    "dev:packages": "turbo run dev --filter='./packages/*' --parallel",
    "android": "turbo run android --filter=mobile",
    "ios": "turbo run ios --filter=mobile",
    "ios:device": "pnpm --filter mobile ios:device",
    "mobile:start": "turbo run start --filter=mobile",
    "pre-push": "./tools/pre-push",
    "lint": "turbo run lint && pnpm lint:guardrails",
    "lint:types": "oxlint --config .oxlintrc.types.json --type-aware apps packages",
    "lint:fix": "turbo run lint -- --fix",
    "lint:guardrails": "pnpm --filter @perawallet/wallet-core-devtools guardrails",
    "lint:guardrails:warn": "pnpm --filter @perawallet/wallet-core-devtools guardrails --warn-only",
    "lint:guardrails:json": "pnpm --silent --filter @perawallet/wallet-core-devtools guardrails --json",
    "lint:i18n": "node tools/i18n-lint.cjs",
    "lint:copyright": "node tools/copyright-header.mjs --fix",
    "lint:copyright:check": "node tools/copyright-header.mjs --check",
    "format": "oxfmt \"**/*.{ts,tsx,md}\"",
    "test": "bash tools/rebuild-native.sh && bash tools/generate-config.sh && turbo run test",
    "test:unit": "bash tools/rebuild-native.sh && bash tools/generate-config.sh && turbo run test:unit",
    "test:coverage": "bash tools/rebuild-native.sh && bash tools/generate-config.sh && turbo run test -- --coverage",
    "test:integration": "bash tools/rebuild-native.sh && bash tools/generate-config.sh && pnpm --recursive --if-present run test:integration",
    "generate:config": "bash tools/generate-config.sh",
    "localnet": "bash tools/localnet.sh start",
    "localnet:stop": "bash tools/localnet.sh stop",
    "localnet:reset": "bash tools/localnet.sh reset",
    "localnet:status": "bash tools/localnet.sh status",
    "localnet:fund": "tsx tools/localnet-fund.ts",
    "bump-version": "bash tools/bump-version.sh",
    "audit": "pnpm audit --prod --audit-level=high",
    "lint:bundle": "bash tools/check-prod-bundle.sh",
    "check:ssl-pins": "node tools/check-pinned-chains.mjs",
    "fallow": "fallow --skip health"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-utils": "catalog:",
    "@babel/runtime": "catalog:",
    "@perawallet/wallet-core-devtools": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "algosdk": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "catalog:",
    "fallow": "3.3.0",
    "msw": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.24.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.9.14",
    "util": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.28.1",
  "name": "with-vite"
}