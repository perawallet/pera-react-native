{
    "name": "@perawallet/wallet-core-site-safety",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "test": "bash ../../tools/dev/rebuild-native.sh && vitest run",
        "test:unit": "bash ../../tools/dev/rebuild-native.sh && vitest run",
        "update:bundled-lists": "tsx scripts/update-bundled-lists.ts",
        "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\""
    },
    "dependencies": {
        "@babel/runtime": "catalog:",
        "@perawallet/wallet-core-database": "workspace:*",
        "@perawallet/wallet-core-shared": "workspace:*",
        "@perawallet/wallet-extension-provider": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "drizzle-orm": "catalog:",
        "punycode": "catalog:",
        "react": "catalog:",
        "zod": "catalog:",
        "zustand": "catalog:"
    },
    "devDependencies": {
        "@perawallet/wallet-core-devtools": "workspace:*",
        "@testing-library/react": "catalog:",
        "@types/react": "catalog:",
        "jsdom": "catalog:",
        "msw": "catalog:",
        "react-dom": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
