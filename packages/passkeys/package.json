        "@tanstack/react-query": "catalog:",
        "@tanstack/store": "catalog:",
        "react": "catalog:"
    },
    "devDependencies": {
        "@perawallet/wallet-core-devtools": "workspace:*",
        "@testing-library/react": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "react-dom": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "catalog:"
