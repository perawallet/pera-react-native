{
  "name": "@perawallet/wallet-core-passkeys",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webauthn": {
      "types": "./dist/webauthn.d.ts",
      "default": "./dist/webauthn.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\""
  },
  "dependencies": {
    "@algorandfoundation/dp256": "catalog:",
    "@algorandfoundation/keystore-core": "catalog:",
    "@algorandfoundation/react-native-keystore": "catalog:",
    "@babel/runtime": "catalog:",
    "@noble/hashes": "catalog:",
    "@perawallet/wallet-core-shared": "workspace:*",
    "@perawallet/wallet-extension-passkey-autofill": "workspace:*",
    "@perawallet/wallet-extension-provider": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/store": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@perawallet/wallet-core-devtools": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
