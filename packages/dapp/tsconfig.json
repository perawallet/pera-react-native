{
    "extends": "@perawallet/wallet-core-devtools/tsconfig/vite.json",
    "compilerOptions": {
        "resolveJsonModule": true,
        // Typecheck-only: the build emits declarations through
        // `tsconfig.build.json` instead, because these `paths` resolve the
        // connections package to its SOURCE. Its own `exports` point at dist, so
        // a stale build there surfaces here as errors in this package's specs.
        // Source files cannot sit in an emitting program (rootDir), hence the split.
        "paths": {
            "@perawallet/wallet-core-connections": [
                "../connections/src/index.ts"
            ],
            "@perawallet/wallet-core-connections/testing": [
                "../connections/src/testing/handler-contract.ts"
            ],
            "@perawallet/wallet-core-connections/pairingOutcome": [
                "../connections/src/pairingOutcome.ts"
            ],
            "@perawallet/wallet-core-connections/handlerKit": [
                "../connections/src/handlerKit.ts"
            ]
        }
    },
    "include": ["src"]
}
