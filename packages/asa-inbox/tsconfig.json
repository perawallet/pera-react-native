{
  "extends": "@perawallet/wallet-core-devtools/tsconfig/vite.json",
  "compilerOptions": {
    // Arc59Client.generated.ts imports types without the type keyword.
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
  },
  "include": [
    "src"
  ],
  "exclude": [
    "**/*.generated.ts"
  ]
}
