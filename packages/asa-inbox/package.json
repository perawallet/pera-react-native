{
  "name": "@perawallet/wallet-core-asa-inbox",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\" --ignore-pattern \"**/*.generated.ts\"",
    "generate:arc59": "pnpm exec algokit-client-generator generate -a src/hooks/arc59-app-spec.json -o src/clients/Arc59Client.generated.ts --preserve-names"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "catalog:",
    "algosdk": "catalog:",
    "@babel/runtime": "catalog:",
    "@perawallet/wallet-core-assets": "workspace:*",
    "@perawallet/wallet-core-blockchain": "workspace:*",
    "@perawallet/wallet-core-config": "workspace:*",
    "@perawallet/wallet-core-shared": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "decimal.js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "6.0.1",
    "@perawallet/wallet-core-devtools": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "msw": "catalog:"
  }
}
