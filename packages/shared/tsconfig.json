{
  "extends": "@perawallet/wallet-core-devtools/tsconfig/vite.json",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@services/*": [
        "./src/services/*"
      ],
      "@store/*": [
        "./src/store/*"
      ],
      "@api/*": [
        "./src/api/*",
        "./src/api/generated/*"
      ],
      "@platform/*": [
        "./src/platform/*"
      ],
      "@test-utils/*": [
        "./src/test-utils/*"
      ],
      "@test-utils": [
        "./src/test-utils/index.ts"
      ]
    },
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src",
    "lib"
  ]
}
