{
  "name": "@perawallet/wallet-core-shared",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "default": "./dist/test-utils/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\"",
    "lint:fix": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\" --fix"
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "algosdk": "catalog:",
    "@perawallet/wallet-core-chain-contract": "workspace:*",
    "@perawallet/wallet-core-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "base64-js": "^1.5.1",
    "decimal.js": "catalog:",
    "ky": "catalog:",
    "react": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@perawallet/wallet-core-devtools": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "oxfmt": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.26.1"
}
