# Local config overrides — GITIGNORED. Consumed by tools/generate-config.sh
# which writes packages/config/src/generated-env.ts (also gitignored).
#
# Copy this file to the PROJECT ROOT as `.env`:
#   cp packages/config/.env.example .env
#
# CONTAINS SECRETS — never commit, never push, never `git add` `.env`.
#
# Native iOS (Config.xcconfig) → React Native (.env) mapping:
#   MOBILE_API_PROD_MAINNET_HOST  → MAINNET_BACKEND_URL
#   MOBILE_API_PROD_TESTNET_HOST  → TESTNET_BACKEND_URL
#   PROD_API_KEY                  → BACKEND_API_KEY
#   ALGOD_MAINNET_HOST            → MAINNET_ALGOD_URL
#   ALGOD_TESTNET_HOST            → TESTNET_ALGOD_URL
#   ALGOD_TOKEN                   → ALGOD_API_KEY
#   INDEXER_MAINNET_HOST          → MAINNET_INDEXER_URL
#   INDEXER_TESTNET_HOST          → TESTNET_INDEXER_URL
#   INDEXER_TOKEN                 → INDEXER_API_KEY
#   BIDALI_PROD_API_KEY           → MAINNET_BIDALI_API_KEY
#   BIDALI_STAGING_API_KEY        → TESTNET_BIDALI_API_KEY
#   WC_V2_PROJECT_ID              → (not wired in RN yet; WalletConnect v1)

# Backend (mobile API)
MAINNET_BACKEND_URL=https://mainnet.api.perawallet.app
TESTNET_BACKEND_URL=https://testnet.api.perawallet.app
BACKEND_API_KEY=

# Algod nodes
MAINNET_ALGOD_URL=https://node-mainnet.chain.perawallet.app
TESTNET_ALGOD_URL=https://node-testnet.chain.perawallet.app
ALGOD_API_KEY=

# Indexer
MAINNET_INDEXER_URL=https://indexer-mainnet.chain.perawallet.app
TESTNET_INDEXER_URL=https://indexer-testnet.chain.perawallet.app
INDEXER_API_KEY=
