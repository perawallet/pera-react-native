{
  "name": "@perawallet/wallet-core-database",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "default": "./dist/test-utils/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "bash ../../tools/rebuild-native.sh && vitest run",
    "test:unit": "bash ../../tools/rebuild-native.sh && vitest run",
    "db:generate": "drizzle-kit generate --name initial",
    "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\""
  },
  "dependencies": {
    "@perawallet/wallet-extension-platform": "workspace:*",
    "decimal.js": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@perawallet/wallet-core-devtools": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
