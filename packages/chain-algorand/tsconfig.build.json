{
  "extends": [
    "./tsconfig.json",
    "@perawallet/wallet-core-devtools/tsconfig/emit.json"
  ],
  "compilerOptions": {
    // Arc59Client.generated.ts ships unused imports and is reached through the
    // import graph, so `exclude` cannot keep it out of the emit program.
    "noUnusedLocals": false,
    "rootDir": "./src",
    "outDir": "./dist",
    // tsconfig.json maps the /testing suites to source for the specs; an
    // emitting program must not pull those in from outside rootDir.
    "paths": {}
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/handlers.ts",
    "**/*-handlers.ts"
  ]
}
