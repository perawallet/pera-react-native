{
  "extends": [
    "./tsconfig.json",
    "@perawallet/wallet-core-devtools/tsconfig/emit.json"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": [],
    // tsconfig.json maps the /testing suite to source for the specs; an
    // emitting program must not pull it in from outside rootDir.
    "paths": {}
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
