{
  "name": "@perawallet/wallet-core-chain-ethereum",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\""
  },
  "dependencies": {
    "@perawallet/wallet-core-accounts": "workspace:*",
    "@perawallet/wallet-core-assets": "workspace:*",
    "@perawallet/wallet-core-chain-contract": "workspace:*",
    "@perawallet/wallet-core-kms": "workspace:*",
    "@perawallet/wallet-core-shared": "workspace:*",
    "decimal.js": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@perawallet/wallet-core-config": "workspace:*",
    "@perawallet/wallet-core-devtools": "workspace:*",
    "@perawallet/wallet-extension-provider": "workspace:*",
    "@types/node": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
