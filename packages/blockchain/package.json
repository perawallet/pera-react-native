{
  "name": "@perawallet/wallet-core-blockchain",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./arc0001/limits": {
      "types": "./dist/arc0001/limits.d.ts",
      "default": "./dist/arc0001/limits.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\""
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "catalog:",
    "algosdk": "catalog:",
    "@babel/runtime": "catalog:",
    "@noble/hashes": "catalog:",
    "@perawallet/wallet-core-chain-contract": "workspace:*",
    "@perawallet/wallet-core-config": "workspace:*",
    "@perawallet/wallet-core-database": "workspace:*",
    "@perawallet/wallet-core-remote-config": "workspace:*",
    "@perawallet/wallet-core-shared": "workspace:*",
    "@perawallet/wallet-extension-provider": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "decimal.js": "catalog:",
    "drizzle-orm": "catalog:",
    "react": "catalog:",
    "tweetnacl": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@perawallet/wallet-core-devtools": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "falcon-1024": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "msw": "catalog:",
    "react-dom": "catalog:"
  }
}
