{
  "name": "@perawallet/wallet-core-walletconnect",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "default": "./dist/v2/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\""
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "@perawallet/wallet-core-accounts": "workspace:*",
    "@perawallet/wallet-core-config": "workspace:*",
    "@perawallet/wallet-core-connections": "workspace:*",
    "@perawallet/wallet-core-kms": "workspace:*",
    "@perawallet/wallet-core-shared": "workspace:*",
    "@perawallet/wallet-core-signing": "workspace:*",
    "@perawallet/wallet-extension-connections": "workspace:*",
    "@perawallet/wallet-extension-platform": "workspace:*",
    "@perawallet/wallet-extension-provider": "workspace:*",
    "@perawallet/walletconnect": "catalog:",
    "@reown/walletkit": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@walletconnect/core": "catalog:",
    "@walletconnect/utils": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@perawallet/wallet-core-devtools": "workspace:*",
    "@types/react": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
