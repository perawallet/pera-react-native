{
  "name": "@perawallet/wallet-extension-platform-react-native",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\""
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "@expensify/react-native-wallet": "^0.1.22",
    "@perawallet/wallet-extension-platform": "workspace:*",
    "@perawallet/wallet-core-hardware-wallet": "workspace:*",
    "@perawallet/wallet-core-config": "workspace:*",
    "@perawallet/wallet-core-shared": "workspace:*",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-mmkv": "catalog:",
    "react-native-cloud-storage": "3.1.0",
    "react-native-ssl-public-key-pinning": "catalog:",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-native-firebase/analytics": "catalog:",
    "@react-native-firebase/crashlytics": "catalog:",
    "@react-native-firebase/messaging": "catalog:",
    "@react-native-firebase/remote-config": "catalog:",
    "@notifee/react-native": "catalog:",
    "drizzle-orm": "catalog:",
    "expo-sqlite": "catalog:",
    "@expo/app-integrity": "catalog:",
    "@noble/hashes": "catalog:",
    "expo-application": "catalog:",
    "expo-device": "catalog:",
    "expo-local-authentication": "catalog:",
    "expo-localization": "catalog:",
    "expo": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@testing-library/react": "catalog:",
    "@perawallet/wallet-core-devtools": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^13.0.3"
  }
}
