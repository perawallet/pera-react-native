{
  "name": "@perawallet/wallet-extension-platform-driver",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/**/__tests__/**\""
  },
  "dependencies": {
    "@perawallet/wallet-extension-platform": "workspace:*"
  },
  "devDependencies": {
    "@perawallet/wallet-core-devtools": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
