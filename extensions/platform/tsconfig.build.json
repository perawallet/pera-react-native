    "./tsconfig.json",
    "@perawallet/wallet-core-devtools/tsconfig/emit.json"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
