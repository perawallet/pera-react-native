# Hoist hermes-compiler so React Native can find hermesc at the expected path
public-hoist-pattern[]=hermes-compiler
# Hoist expo-modules-core so Metro can resolve it from any Expo package.
# Many Expo packages import expo-modules-core at runtime without declaring
# it as a dependency, relying on hoisting to make it available.
public-hoist-pattern[]=expo-modules-core
public-hoist-pattern[]=@expo/config-plugins

# Supply-chain hardening settings live in pnpm-workspace.yaml
# (minimumReleaseAge, minimumReleaseAgeExclude) so pnpm picks them up
# with workspace-aware resolution.
