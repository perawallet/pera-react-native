+        if (written && written.password === password) {
+            hasTeeCopy = true;
+            return;
+        }
+    }
+    catch {
+        // Falls through to the cleanup; the StrongBox copy is untouched.
+    }
+    await Keychain.resetGenericPassword({ service: TEE_SERVICE }).catch(() => undefined);
