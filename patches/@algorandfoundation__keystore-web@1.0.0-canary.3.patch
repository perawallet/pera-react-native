+    // PERA PATCH: create under a cross-context lock, and re-read once held.
+    //
+    // Every context that builds a driver (service worker, offscreen document,
+    // each extension page) runs this concurrently at first use. Unpatched, all
+    // of them miss the read, all generate, and the last `put` wins — while each
+    // context keeps the key IT generated cached in the driver closure. Material
+    // sealed by one context then cannot be opened by another, surfacing as a
+    // bare `OperationError` from AES-GCM with no message.
+    //
+    // Web Locks are shared across every same-origin context including workers,
+    // so the first caller creates and the rest re-read what it wrote. Where the
+    // API is absent (non-browser test envs) the double-check alone still shrinks
+    // the window to nothing meaningful.
+    const createMasterKey = async () => {
+        const raced = await db.get(MATERIAL_STORE, MASTER_KEY_ID);
+        if (raced && raced.kind === "cryptokey") {
+            return raced.privateKey;
+        }
+        const master = await subtle.generateKey({ name: "AES-GCM", length: 256 }, false, [
+            "encrypt",
+            "decrypt",
+        ]);
+        await db.put(MATERIAL_STORE, {
+            id: MASTER_KEY_ID,
+            kind: "cryptokey",
+            privateKey: master,
+        });
+        return master;
+    };
+    const locks = globalThis.navigator && globalThis.navigator.locks;
+    if (!locks) {
+        return createMasterKey();
+    }
+    return locks.request("keystore-master-key-init", createMasterKey);
 }
