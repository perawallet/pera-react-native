+        self?.authenticateAndCompletePassword()
+      }
+    }
+  }
+
+  /// Lists the logins matching the request. Summaries only — the picker shows a
+  /// username and a host, and neither it nor this controller holds a password.
+  ///
+  /// `cancelIfEmpty` covers the WebAuthn caller: unlike Pera's own password
+  /// picker, that caller expects `.credentialIdentityNotFound` when nothing
+  /// matches, not an empty sheet the user has to dismiss by hand.
+  func offerLogins(
