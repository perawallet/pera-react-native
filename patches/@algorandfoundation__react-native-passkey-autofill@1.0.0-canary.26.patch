+extension CredentialProviderViewController: UITableViewDataSource, UITableViewDelegate {
+  /// Holds the id of the login the system asked for. The record is not opened
+  /// here: the password is read after `evaluatePolicy` succeeds and used
+  /// immediately, so no decrypted password waits on a prompt.
+  func preparePassword(recordIdentifier: String?) {
+    guard let recordIdentifier else {
+      store?.appendDiagnostic("password request carried no record identifier")
+      cancel(code: .credentialIdentityNotFound, message: "Credential identity not found.")
+      return
+    }
+
+    pendingPasswordRecordIdentifier = recordIdentifier
+    showCheckingLogins()
+
