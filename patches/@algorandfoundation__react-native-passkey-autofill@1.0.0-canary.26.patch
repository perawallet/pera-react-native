diff --git a/android/src/main/java/co/algorand/passkeyautofill/PrivilegedBrowsers.kt b/android/src/main/java/co/algorand/passkeyautofill/PrivilegedBrowsers.kt
new file mode 100644
index 0000000000000000000000000000000000000000..76c818b12e0b1f4f1d325249b6ec10897a786b8b
--- /dev/null
+++ b/android/src/main/java/co/algorand/passkeyautofill/PrivilegedBrowsers.kt
@@ -0,0 +1,71 @@
+package co.algorand.passkeyautofill
+
+import android.content.Context
+import android.util.Log
+import androidx.credentials.provider.CallingAppInfo
+
+/**
+ * PERA LOCAL PATCH — resolves the *web* origin a privileged browser is acting on
+ * behalf of.
+ *
+ * Credential Manager populates `CallingAppInfo.origin` when a browser holding
+ * `android.permission.CREDENTIAL_MANAGER_SET_ORIGIN` makes a WebAuthn call for a
+ * page. That value is the origin the page (and the relying party) expects to see
+ * in clientData; the caller's own `android:apk-key-hash:…` identity is not. But
+ * AndroidX keeps `origin` internal and only exposes it through
+ * [CallingAppInfo.getOrigin], which requires the caller to be matched against a
+ * privileged-app allowlist first — so shipping an allowlist is the only way to
+ * read it, and the check is the point rather than an obstacle: without it any
+ * caller that could set an origin could dictate what we sign it as.
+ *
+ * `res/raw/passkey_privileged_browsers.json` is Google's published allowlist
+ * (https://www.gstatic.com/gpm-passkeys-privileged-apps/apps.json) — the same
+ * set Google Password Manager trusts. `userdebug` fingerprints in it only apply
+ * on `userdebug` builds; AndroidX filters them by `Build.TYPE`.
+ *
+ * Every failure path returns null, which means "treat this as an ordinary app
+ * call" — the pre-existing behaviour. A browser missing from the allowlist is
+ * therefore no worse off than before the patch, so refreshing the JSON is
+ * maintenance rather than a correctness dependency.
+ */
+object PrivilegedBrowsers {
+    private const val TAG = "PrivilegedBrowsers"
+
+    @Volatile
+    private var cachedAllowlist: String? = null
+
+    /**
+     * The web origin [info] is acting for (e.g. `https://example.com`), or null
+     * when the caller is not an allowlisted browser or claimed no origin.
+     */
+    fun webOrigin(context: Context, info: CallingAppInfo): String? {
+        if (!info.isOriginPopulated()) return null
+        val allowlist = allowlist(context) ?: return null
+        return try {
+            info.getOrigin(allowlist)
+        } catch (e: IllegalStateException) {
+            // Origin set by a caller that is not on the allowlist. Deliberately
+            // not fatal: we fall back to the app-identity origin rather than
+            // honouring an unverifiable claim.
+            Log.w(TAG, "${info.packageName} claimed a web origin but is not an allowlisted browser")
+            null
+        } catch (e: IllegalArgumentException) {
+            Log.e(TAG, "Privileged browser allowlist is malformed", e)
+            null
+        }
+    }
+
+    private fun allowlist(context: Context): String? {
+        cachedAllowlist?.let { return it }
+        return try {
+            context.resources
+                .openRawResource(R.raw.passkey_privileged_browsers)
+                .bufferedReader()
+                .use { it.readText() }
+                .also { cachedAllowlist = it }
+        } catch (e: Exception) {
+            Log.e(TAG, "Could not read the privileged browser allowlist", e)
+            null
+        }
+    }
+}
