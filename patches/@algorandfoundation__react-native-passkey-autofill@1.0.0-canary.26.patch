@@ -0,0 +1,43 @@
+package co.algorand.passkeyautofill
+
+import android.os.Bundle
+import co.algorand.passkeyautofill.autofill.AutofillPickerComponent
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+// Bundle is a framework class the plain JUnit stub jar can't construct;
+// Robolectric provides a real implementation. Pinned to 34 — the module
+// targets 36, but Robolectric 4.11.1 doesn't support an SDK that high yet.
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class AutofillPickerComponentTest {
+    @Test
+    fun `returns the configured component name`() {
+        val bundle = Bundle().apply {
+            putString(AutofillPickerComponent.META_DATA_NAME, "PeraAutofillPicker")
+        }
+        assertEquals("PeraAutofillPicker", AutofillPickerComponent.fromMetaData(bundle))
+    }
+
+    @Test
+    fun `returns null when the bundle is absent`() {
+        assertNull(AutofillPickerComponent.fromMetaData(null))
+    }
+
+    @Test
+    fun `returns null when the key is missing`() {
+        assertNull(AutofillPickerComponent.fromMetaData(Bundle()))
+    }
+
+    @Test
+    fun `returns null when the value is blank`() {
+        val bundle = Bundle().apply {
+            putString(AutofillPickerComponent.META_DATA_NAME, "   ")
+        }
+        assertNull(AutofillPickerComponent.fromMetaData(bundle))
+    }
+}
