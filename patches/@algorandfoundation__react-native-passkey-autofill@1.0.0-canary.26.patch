@@ -0,0 +1,73 @@
+package co.algorand.passkeyautofill.autofill
+
+import android.content.Context
+import androidx.annotation.VisibleForTesting
+import com.tencent.mmkv.MMKV
+
+/**
+ * Caller-to-login associations asserted by the user when they pick a login for
+ * a caller that has none.
+ *
+ * Its own mmapID: the "keystore" instance must stay empty of non-keystore keys
+ * or master-key minting fails on a fresh install, and defaultMMKV already
+ * holds the credential provider's own bookkeeping.
+ */
+object AppLinkStore {
+    private const val MMAP_ID = "pera_autofill_app_links"
+
+    /**
+     * Neither a package name nor a host may contain it, so a key parses back
+     * unambiguously and no package can forge another's key by naming itself.
+     */
+    private const val SEPARATOR = '|'
+
+    /**
+     * The storage key a link is asserted under.
+     *
+     * A caller that rendered a page and told us its domain is linked per
+     * *origin*, not per package. Keying such a caller on its package alone
+     * would let a link made on one page answer on every other page it ever
+     * renders — an in-app browser would offer a bank login to a phishing page
+     * and label it with the bank's host. A caller that claimed no domain is an
+     * ordinary native app with a single identity, and stays package-keyed:
+     * that is the case the user-asserted link was designed for.
+     */
+    @VisibleForTesting
+    internal fun linkKey(packageName: String, host: String?): String =
+        if (host.isNullOrEmpty()) packageName else "$packageName$SEPARATOR$host"
+
+    fun linksFor(context: Context, packageName: String, host: String?): Set<String> =
+        store(context).decodeStringSet(linkKey(packageName, host), emptySet()) ?: emptySet()
+
+    fun link(context: Context, packageName: String, host: String?, recordIdentifier: String) {
+        val key = linkKey(packageName, host)
+        val next = linksFor(context, packageName, host) + recordIdentifier
+        store(context).encode(key, next)
+    }
+
+    /**
+     * Drops [recordIdentifier] from every key, and empty keys with it.
+     *
+     * Iterates raw keys rather than reconstructing them: one login may be
+     * linked under a package alone and under several of that package's hosts,
+     * and a delete has to reach all of them or the picker keeps offering an
+     * entry that no longer resolves.
+     */
+    fun prune(context: Context, recordIdentifier: String) {
+        val mmkv = store(context)
+        mmkv.allKeys()?.forEach { key ->
+            val current = mmkv.decodeStringSet(key, emptySet()) ?: emptySet()
+            val next = current - recordIdentifier
+            if (next.isEmpty()) mmkv.removeValueForKey(key) else mmkv.encode(key, next)
+        }
+    }
+
+    fun clear(context: Context) {
+        store(context).clearAll()
+    }
+
+    private fun store(context: Context): MMKV {
+        MMKV.initialize(context)
+        return MMKV.mmkvWithID(MMAP_ID)
+    }
+}
