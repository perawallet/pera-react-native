+package co.algorand.passkeyautofill.autofill
+
+import android.app.assist.AssistStructure
+import android.os.Build
+import android.text.InputType
+import android.util.Log
+import android.view.View
+import android.view.autofill.AutofillId
+import androidx.annotation.RequiresApi
+
+/**
+ * PERA LOCAL PATCH — the login field pair found in a client's view structure.
+ */
+@RequiresApi(Build.VERSION_CODES.O)
+data class FillTarget(
+    val usernameId: AutofillId?,
+    val passwordId: AutofillId,
+    /**
+     * The domain in effect at the password field, or null.
+     *
+     * **A claim, not an identity.** `ViewStructure.setWebDomain` is written by
+     * the client app, so any app can draw a text field and assert any domain on
+     * it. Nothing may act on this without [AutofillScope.resolve] first deciding
+     * what the caller is.
+     */
+    val webDomain: String?,
+    /**
+     * The scheme in effect at the password field, or null below API 28 where
+     * `ViewNode.getWebScheme()` does not exist. Same standing as [webDomain]:
+     * a claim by the client, useful only once the caller has been identified.
+     */
+    val webScheme: String?,
+    val packageName: String,
+)
+
+/**
+ * PERA LOCAL PATCH — finds the password field, and the username field that goes
+ * with it, in the structure the platform hands an `AutofillService`.
+ *
+ * The shape is a heuristic because the input is: apps and pages label fields as
+ * they please. It is allowed to be wrong about *which* fields to offer, because
+ * the user still confirms; it is not allowed to be wrong about *whose* they are,
+ * which is why the domain travels with the field rather than being read off the
+ * structure as a whole.
+ */
+@RequiresApi(Build.VERSION_CODES.O)
+object FillStructureParser {
+    private const val TAG = "FillStructureParser"
+
+    /**
+     * Bounds on an untrusted structure. A client controls the hierarchy it
+     * reports, so an unbounded walk is a `StackOverflowError` it can trigger at
+     * will — and an `Error` escapes the `catch (e: Exception)` on every caller.
+     * Real login forms sit orders of magnitude inside both numbers; exceeding
+     * either means the structure is not one, so the walk is abandoned rather
+     * than truncated. A truncated walk could drop the field that carried the
+     * domain and mis-attribute the rest.
+     */
+    private const val MAX_DEPTH = 128
+    private const val MAX_NODES = 4096
+
+    /**
+     * Browsers forward a field's `autocomplete` token as its autofill hint, so
+     * the web spellings sit alongside the platform constants. Missing one costs
+     * a silent non-fill on exactly the pages this feature exists for.
+     */
+    private val PASSWORD_HINTS = setOf(
+        View.AUTOFILL_HINT_PASSWORD,
+        "current-password",
+        "new-password",
+    )
+
+    private val USERNAME_HINTS = setOf(
+        View.AUTOFILL_HINT_USERNAME,
+        View.AUTOFILL_HINT_EMAIL_ADDRESS,
+        "email",
+    )
+
+    /**
+     * The fillable pair in [structure], or null when there is nothing to fill.
+     *
+     * Catches [Throwable] rather than [Exception] on purpose: the input is
+     * client-supplied, [MAX_DEPTH] is a guess about it, and a
+     * `StackOverflowError` getting past this would take down the fill request
+     * instead of declining it. Every other path in this change fails closed;
+     * so does this one.
+     */
+    fun parse(structure: AssistStructure, packageName: String): FillTarget? = try {
+        parseStructure(structure, packageName)
+    } catch (e: Throwable) {
+        Log.w(TAG, "Could not read the assist structure from $packageName", e)
+        null
+    }
+
+    private fun parseStructure(structure: AssistStructure, packageName: String): FillTarget? {
+        val fields = mutableListOf<Field>()
+        val budget = Budget()
+        for (i in 0 until structure.windowNodeCount) {
+            val root = structure.getWindowNodeAt(i).rootViewNode ?: continue
+            if (!collect(root, null, null, fields, budget, depth = 0)) return null
+        }
+
+        val password = focusedPassword(fields)
+            ?: fields.firstOrNull { isPassword(it.node) }
+            ?: return null
+        val passwordId = password.node.autofillId ?: return null
+
+        // Only fields from the same frame are part of the same form. Pairing
+        // across that boundary would put a username from one origin's page into
+        // a request carrying another's domain.
+        val preceding = fields
+            .takeWhile { it !== password }
+            .filter { it.webDomain == password.webDomain }
+        // An explicit hint beats position; otherwise the field immediately above
+        // the password is the conventional guess.
+        val username = preceding.lastOrNull { isUsername(it.node) } ?: preceding.lastOrNull()
+
+        return FillTarget(
+            usernameId = username?.node?.autofillId,
+            passwordId = passwordId,
+            webDomain = password.webDomain,
+            webScheme = password.webScheme,
+            packageName = packageName,
+        )
+    }
+
+    /**
+     * The password field belonging to the form the user is actually in.
+     *
+     * Document order alone picks the first password on the screen, which on a
+     * page carrying two forms — a signup above a login, or a hidden legacy form
+     * — is the wrong one: the fill lands in the wrong field and, worse, the
+     * request is scoped by the wrong form's domain. Focus is the only signal in
+     * the structure that says which form is live, so it wins where it exists.
+     *
+     * Searching forward from focus before backward matches how a form is
+     * traversed: the focused field is usually the username, with its password
+     * below it.
+     */
+    private fun focusedPassword(fields: List<Field>): Field? {
+        val focused = fields.indexOfFirst { it.node.isFocused }
+        if (focused < 0) return null
+        return fields.drop(focused).firstOrNull { isPassword(it.node) }
+            ?: fields.take(focused + 1).lastOrNull { isPassword(it.node) }
+    }
+
+    /** A fillable text field, with the domain that was in effect where it sat. */
+    private data class Field(
+        val node: AssistStructure.ViewNode,
+        val webDomain: String?,
+        val webScheme: String?,
+    )
+
+    /**
+     * Flattens the fillable text fields in document order, carrying each one's
+     * nearest ancestor `webDomain` down to it.
+     *
+     * Taking the first domain found anywhere in the structure instead would let
+     * a cross-origin iframe name the domain for a password field that does not
+     * belong to it.
+     */
+    private class Budget(var remainingNodes: Int = MAX_NODES)
+
+    /** False when the structure outran [MAX_DEPTH] or [MAX_NODES]. */
+    private fun collect(
+        node: AssistStructure.ViewNode,
+        inheritedDomain: String?,
+        inheritedScheme: String?,
+        into: MutableList<Field>,
+        budget: Budget,
+        depth: Int,
+    ): Boolean {
+        if (depth > MAX_DEPTH || budget.remainingNodes <= 0) return false
+        budget.remainingNodes--
+
+        val domain = node.webDomain?.takeIf { it.isNotEmpty() } ?: inheritedDomain
+        // The scheme travels with the domain it qualifies: an http frame nested
+        // in an https page must not inherit the parent's scheme, or the mixed
+        // content would read as secure.
+        val scheme = node.scheme()?.takeIf { it.isNotEmpty() }
+            ?: inheritedScheme.takeIf { node.webDomain.isNullOrEmpty() }
+        if (node.autofillId != null && node.autofillType == View.AUTOFILL_TYPE_TEXT) {
+            into += Field(node, domain, scheme)
+        }
+        for (i in 0 until node.childCount) {
+            val child = node.getChildAt(i) ?: continue
+            if (!collect(child, domain, scheme, into, budget, depth + 1)) return false
+        }
+        return true
+    }
+
+    /** Null below API 28, where `ViewNode.getWebScheme()` does not exist. */
+    private fun AssistStructure.ViewNode.scheme(): String? =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) webScheme else null
+
+    private fun isPassword(node: AssistStructure.ViewNode): Boolean {
+        if (node.hasHint(PASSWORD_HINTS)) return true
+        val inputType = node.inputType
+        if (inputType and InputType.TYPE_MASK_CLASS != InputType.TYPE_CLASS_TEXT) return false
+        return when (inputType and InputType.TYPE_MASK_VARIATION) {
+            InputType.TYPE_TEXT_VARIATION_PASSWORD,
+            InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD,
+            InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD,
+            -> true
+
+            else -> false
+        }
+    }
+
+    private fun isUsername(node: AssistStructure.ViewNode): Boolean =
+        node.hasHint(USERNAME_HINTS)
+
+    private fun AssistStructure.ViewNode.hasHint(hints: Set<String>): Boolean =
+        autofillHints?.any { candidate ->
+            hints.any { it.equals(candidate, ignoreCase = true) }
+        } == true
+}
