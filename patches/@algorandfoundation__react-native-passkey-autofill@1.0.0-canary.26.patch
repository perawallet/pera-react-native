+package co.algorand.passkeyautofill
+
+import android.content.Context
+import android.util.Log
+import androidx.credentials.provider.CallingAppInfo
+import co.algorand.passkeyautofill.credentials.CredentialRepository
+import org.json.JSONObject
+
+/**
+ * PERA LOCAL PATCH — a login the wallet sealed into the shared keystore.
+ *
+ * `password` is the reason this type exists, so treat an instance as secret:
+ * build one only to answer a request that has already been user-verified, and
+ * never log it or put it in a Bundle that outlives the release.
+ */
+data class StoredLogin(
+    /**
+     * The keystore record id (`pera.login.<uuid>`), which is also what the
+     * provider's PendingIntent carries to say which login to release.
+     */
+    val recordIdentifier: String,
+    val domain: String,
+    val username: String,
+    val password: String,
+    val note: String?,
+    /** Epoch **milliseconds**, as the wallet writes them. */
+    val createdAt: Long,
+    val updatedAt: Long,
+)
+
+/**
+ * PERA LOCAL PATCH — what a login can say about itself without its secret:
+ * enough to list it, match it against a caller and label an entry.
+ *
+ * Every bulk read returns these. [StoredLogin] — the only shape carrying the
+ * password — is reachable one record at a time, so nothing can hold a set of
+ * decrypted passwords.
+ */
+data class LoginSummary(
+    val recordIdentifier: String,
+    /** The stored domain reduced to a comparable host, e.g. `example.com`. */
+    val host: String,
+    val username: String,
+)
+
+/**
+ * PERA LOCAL PATCH — reads the wallet's logins out of the same shared keystore
+ * MMKV instance the passkey path uses, through [CredentialRepository]'s record
+ * accessors, so the master key and the sealing envelope keep exactly one
+ * implementation.
+ *
+ * Nothing here writes: the wallet owns the record lifecycle and this is a
+ * reader that answers `BeginGetPasswordOption`.
+ */
+class PasswordCredentialStore(
+    private val repository: CredentialRepository = CredentialRepository(),
+) {
+    companion object {
+        /**
+         * Plaintext discriminator the wallet writes into `k/<id>` metadata.
+         * Logins share the canonical `secret-key` record type with the hashed
+         * PIN, the mirrored biometric blob and the card session tokens, so the
+         * record type cannot tell them apart — this is what does.
+         */
+        const val LOGIN_KIND = "login"
+
+        /**
+         * The only sealed-payload version this build understands. A record
+         * written by a newer wallet is skipped rather than guessed at.
+         */
+        const val PAYLOAD_VERSION = 1
+
+        /**
+         * A stored `example.com` answers a request for `example.com` and for
+         * any subdomain of it.
+         *
+         * The subdomain test requires the dot: a plain suffix check would hand
+         * `example.com`'s password to `evil-example.com`, and matching anywhere
+         * in the string would do it in both directions. It also requires the
+         * *stored* host to contain a dot before it is allowed to match a
+         * subdomain — without that, a login stored as the bare public-suffix
+         * label `com` would answer every `*.com` site.
+         */
+        fun domainMatches(storedDomain: String, requestedHost: String): Boolean {
+            val storedHost = host(storedDomain)
+            if (storedHost.isEmpty() || requestedHost.isEmpty()) return false
+            if (storedHost == requestedHost) return true
+            if (!storedHost.contains(".")) return false
+            return requestedHost.endsWith(".$storedHost")
+        }
+
+        /**
+         * The comparable host of a stored domain or of a caller's verified web
+         * origin.
+         *
+         * A stored domain is whatever the user typed and a verified origin is a
+         * full URL, so both sides are reduced the same way: scheme, userinfo,
+         * port, path and the root label's trailing dot all dropped, then
+         * case-folded. `lowercase()` is the locale-independent overload on
+         * purpose — the Turkish locale would otherwise fold `I` to `ı`.
+         */
+        fun host(identifier: String): String {
+            var value = identifier.trim().lowercase()
+            val schemeEnd = value.indexOf("://")
+            if (schemeEnd >= 0) {
+                value = value.substring(schemeEnd + 3)
+            }
+            val pathStart = value.indexOfFirst { it == '/' || it == '?' || it == '#' }
+            if (pathStart >= 0) {
+                value = value.substring(0, pathStart)
+            }
+            val userInfoEnd = value.lastIndexOf('@')
+            if (userInfoEnd >= 0) {
+                value = value.substring(userInfoEnd + 1)
+            }
+            // A bracketed IPv6 literal's colons belong to the address.
+            val portStart = value.lastIndexOf(':')
+            if (portStart >= 0 && !value.startsWith("[")) {
+                value = value.substring(0, portStart)
+            }
+            return value.trimEnd('.')
+        }
+
+        /**
+         * Reads the summary half of the payload the wallet's
+         * `encodeLoginPayload` writes (`packages/passwords/src/models/login.ts`):
+         * UTF-8 JSON, no envelope of its own.
+         *
+         * Deliberately does not bind `password` — listing logins must not put a
+         * decrypted password into a variable that outlives the parse.
+         */
+        fun decodeSummary(payload: ByteArray, recordIdentifier: String): LoginSummary? {
+            val json = parse(payload) ?: return null
+            val domain = json.optString("domain").takeUnless { it.isEmpty() } ?: return null
+            if (json.isNull("username") || json.isNull("password")) return null
+            // Mirror decode()'s shape check so a malformed record is rejected
+            // the same way in both readers instead of surfacing here and only
+            // failing later, at release, when decode() is the one called.
+            json.opt("createdAt") as? Number ?: return null
+            json.opt("updatedAt") as? Number ?: return null
+            val host = host(domain)
+            if (host.isEmpty()) return null
+            return LoginSummary(recordIdentifier, host, json.optString("username"))
+        }
+
+        /** The whole payload, password included. See [StoredLogin]. */
+        fun decode(payload: ByteArray, recordIdentifier: String): StoredLogin? {
+            val json = parse(payload) ?: return null
+            val domain = json.optString("domain").takeUnless { it.isEmpty() } ?: return null
+            if (json.isNull("username") || json.isNull("password")) return null
+            val createdAt = json.opt("createdAt") as? Number ?: return null
+            val updatedAt = json.opt("updatedAt") as? Number ?: return null
+            return StoredLogin(
+                recordIdentifier = recordIdentifier,
+                domain = domain,
+                username = json.optString("username"),
+                password = json.optString("password"),
+                note = if (json.isNull("note")) null else json.optString("note"),
+                createdAt = createdAt.toLong(),
+                updatedAt = updatedAt.toLong(),
+            )
+        }
+
+        private fun parse(payload: ByteArray): JSONObject? {
+            val json = try {
+                JSONObject(String(payload, Charsets.UTF_8))
+            } catch (e: Exception) {
+                return null
+            }
+            return if (json.optInt("v", -1) == PAYLOAD_VERSION) json else null
+        }
+    }
+
+    /**
+     * Every login, as summaries. The sealed payload is opened to read the
+     * domain and username — they live inside it — but the password is never
+     * bound, so none is retained past this call.
+     *
+     * The plaintext metadata index narrows the set to logins first, so a wallet
+     * full of seeds and passkeys costs one MMKV read rather than an unseal per
+     * record.
+     */
+    fun loginSummaries(context: Context): List<LoginSummary> =
+        repository.recordMetadataById(context)
+            .filterValues { isLoginRecord(it) }
+            .keys
+            .mapNotNull { summaryOf(context, it) }
+            .sortedWith(compareBy({ it.host }, { it.username }))
+
+    /** The summary of one record, or null when it is not a readable login. */
+    fun loginSummary(context: Context, recordIdentifier: String): LoginSummary? {
+        if (!isLoginRecord(repository.recordMetadata(context, recordIdentifier))) return null
+        return summaryOf(context, recordIdentifier)
+    }
+
+    /**
+     * The one way to reach a password, one record at a time. Call it when
+     * something is about to use the secret — never to build a list.
+     */
+    fun login(context: Context, recordIdentifier: String): StoredLogin? {
+        if (!isLoginRecord(repository.recordMetadata(context, recordIdentifier))) return null
+        val payload = repository.recordMaterial(context, recordIdentifier) ?: return null
+        return decode(payload, recordIdentifier)
+    }
+
+    private fun summaryOf(context: Context, recordIdentifier: String): LoginSummary? {
+        val payload = repository.recordMaterial(context, recordIdentifier) ?: return null
+        return decodeSummary(payload, recordIdentifier)
+    }
+
+    /**
+     * Whether a plaintext metadata record is one of the wallet's logins. This
+     * is what keeps a non-login record from ever being unsealed.
+     */
+    private fun isLoginRecord(record: JSONObject?): Boolean {
+        if (record == null) return false
+        val metadata = record.optJSONObject("metadata")
+        val kind = metadata?.optString("kind").takeUnless { it.isNullOrEmpty() }
+            ?: record.optString("kind").takeUnless { it.isEmpty() }
+        return kind == LOGIN_KIND
+    }
+}
+
+/**
+ * PERA LOCAL PATCH — who a password request is on behalf of, resolved from the
+ * caller's *verified* identity and never from anything the request claims.
+ *
+ * The passkey branch of the provider scopes every offered credential to the
+ * asserted relying party or to the calling app's own signing identity. A
+ * password query carries no relying party at all, so the equivalent scope has
+ * to come from `CallingAppInfo`. Without it, any installed app that asks for a
+ * password credential is handed every login in the store.
+ */
+sealed class PasswordCallerScope {
+    /**
+     * An allowlisted browser acting for a page. [host] comes from the origin
+     * Credential Manager populated and [PrivilegedBrowsers] verified against
+     * the browser's signing certificate, so it is the caller's identity rather
+     * than its claim.
+     */
+    data class Web(val host: String) : PasswordCallerScope()
+
+    /**
+     * Any other caller, identified only by its package. **Matches nothing.**
+     *
+     * Binding a package to a domain soundly needs a Digital Asset Links
+     * statement fetched from that domain
+     * (`delegate_permission/common.get_login_creds`) and checked against the
+     * caller's signing certificate, which nothing in this module can do yet.
+     * The obvious shortcut — reversing the package name into a host — is not a
+     * weaker form of that check but a hole: a sideloaded `com.<victim>.anything`
+     * would then claim `<victim>.com`. So an app caller is scoped to the empty
+     * set, the same fail-closed choice the passkey branch makes for a caller
+     * that supplies no relying-party id.
+     *
+     * Know what that costs before changing it. A password option carries no
+     * domain of its own ([androidx.credentials.GetPasswordOption] has only
+     * `allowedUserIds`), and the platform's own
+     * `com.android.credentialmanager.autofill.CredentialAutofillService` bridge
+     * turns ordinary form fields into password options whose caller is the app
+     * being filled, with no origin set. So this branch is the common one, and
+     * while it returns false the provider offers logins to browsers that pass a
+     * verified origin and to nothing else. Closing that gap means giving a
+     * login a verified app association, not loosening the check here.
+     */
+    data class App(val packageName: String) : PasswordCallerScope()
+
+    /** Whether a login stored for [storedDomain] may be offered to this caller. */
+    fun matches(storedDomain: String): Boolean = when (this) {
+        is Web -> PasswordCredentialStore.domainMatches(storedDomain, host)
+        is App -> false
+    }
+
+    companion object {
+        private const val TAG = "PasswordCallerScope"
+
+        /**
+         * The scope of [info], or null when the caller cannot be identified at
+         * all — `callingAppInfo` is nullable on the provider requests, and a
+         * request nobody can be held to gets no entries.
+         */
+        fun resolve(context: Context, info: CallingAppInfo?): PasswordCallerScope? {
+            if (info == null) return null
+            val webOrigin = try {
+                PrivilegedBrowsers.webOrigin(context, info)
+            } catch (e: Exception) {
+                Log.e(TAG, "Could not resolve the caller's web origin", e)
+                null
+            }
+            if (webOrigin != null) {
+                val host = PasswordCredentialStore.host(webOrigin)
+                if (host.isNotEmpty()) return Web(host)
+            }
+            return App(info.packageName)
+        }
+    }
+}
