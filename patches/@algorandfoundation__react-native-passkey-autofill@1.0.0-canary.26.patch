+package co.algorand.passkeyautofill.autofill
+
+import android.app.PendingIntent
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.os.CancellationSignal
+import android.service.autofill.AutofillService
+import android.service.autofill.Dataset
+import android.service.autofill.FillCallback
+import android.service.autofill.FillRequest
+import android.service.autofill.FillResponse
+import android.service.autofill.SaveCallback
+import android.service.autofill.SaveRequest
+import android.util.Log
+import android.view.autofill.AutofillValue
+import android.widget.RemoteViews
+import androidx.annotation.RequiresApi
+import co.algorand.passkeyautofill.PasswordCredentialStore
+import co.algorand.passkeyautofill.R
+
+@RequiresApi(Build.VERSION_CODES.O)
+class PeraAutofillService : AutofillService() {
+
+    private val store = PasswordCredentialStore()
+
+    override fun onFillRequest(
+        request: FillRequest,
+        cancellationSignal: CancellationSignal,
+        callback: FillCallback,
+    ) {
+        var cancelled = false
+        cancellationSignal.setOnCancelListener { cancelled = true }
+
+        // The platform disables a service that throws out of onFillRequest, so
+        // every path below terminates in onSuccess rather than propagating.
+        try {
+            val context = request.fillContexts.lastOrNull()
+            if (context == null) { callback.onSuccess(null); return }
+
+            val clientPackage = context.structure.activityComponent.packageName
+            val target = FillStructureParser.parse(context.structure, clientPackage)
+            if (target == null) { callback.onSuccess(null); return }
+
+            val scope = AutofillScope.resolve(this, target)
+            val response = when (scope) {
+                is AutofillScope.UnlinkedApp -> pickerResponse(target, scope)
+                is AutofillScope.Web, is AutofillScope.LinkedApp -> matchedResponse(target, scope)
+                // A verified browser with no resolvable host must be offered nothing at
+                // all: routing it to the picker would let the user link a login to the
+                // browser package itself, which would then surface on every page it renders.
+                is AutofillScope.UnscopedBrowser -> null
+            }
+            if (!cancelled) callback.onSuccess(response)
+        } catch (e: Exception) {
+            Log.e(TAG, "Fill request failed", e)
+            callback.onSuccess(null)
+        }
+    }
+
+    /**
+     * Required by AutofillService. Capturing credentials typed into a form is
+     * out of scope, and reporting it here stops the OS offering a save prompt
+     * this build cannot honour.
+     */
+    override fun onSaveRequest(request: SaveRequest, callback: SaveCallback) {
+        callback.onFailure(null)
+    }
+
+    private fun matchedResponse(target: FillTarget, scope: AutofillScope): FillResponse? {
+        val matches = store.loginSummaries(this).filter {
+            scope.matches(it.host, it.recordIdentifier)
+        }
+        if (matches.isEmpty()) return null
+
+        val builder = FillResponse.Builder()
+        matches.forEach { summary ->
+            builder.addDataset(
+                dataset(
+                    target = target,
+                    label = "${summary.username} — ${summary.host}",
+                    auth = authIntent(FillAuthActivity::class.java, target).apply {
+                        putExtra(EXTRA_RECORD_ID, summary.recordIdentifier)
+                        data = Uri.parse("pera-autofill:${summary.recordIdentifier}")
+                    },
+                ),
+            )
+        }
+        return builder.build()
+    }
+
+    private fun pickerResponse(
+        target: FillTarget,
+        scope: AutofillScope.UnlinkedApp,
+    ): FillResponse? {
+        if (store.loginSummaries(this).isEmpty()) return null
+        // The host the caller claimed travels to the picker so the link it
+        // writes is scoped to the page the user is actually looking at. The
+        // scope resolved it, so the picker cannot key the link differently
+        // from the lookup that will later read it back.
+        val host = scope.host
+        return FillResponse.Builder()
+            .addDataset(
+                dataset(
+                    target = target,
+                    label = getString(R.string.pera_autofill_pick_login),
+                    auth = authIntent(PeraPickerActivity::class.java, target).apply {
+                        putExtra(EXTRA_PACKAGE_NAME, scope.packageName)
+                        host?.let { putExtra(EXTRA_WEB_HOST, it) }
+                        data = Uri.parse("pera-autofill-pick:${scope.packageName}|${host.orEmpty()}")
+                    },
+                ),
+            )
+            .build()
+    }
+
+    /**
+     * Placeholder values only. Real credentials are supplied by the auth
+     * activity's result, so nothing secret is ever handed to the platform in a
+     * FillResponse.
+     */
+    private fun dataset(target: FillTarget, label: String, auth: Intent): Dataset {
+        val presentation = RemoteViews(packageName, android.R.layout.simple_list_item_1).apply {
+            setTextViewText(android.R.id.text1, label)
+        }
+        val builder = Dataset.Builder()
+        target.usernameId?.let { builder.setValue(it, AutofillValue.forText(""), presentation) }
+        builder.setValue(target.passwordId, AutofillValue.forText(""), presentation)
+
+        // A distinct Intent.data per entry: PendingIntents that differ only by
+        // extras are treated as equal and collapse into one.
+        builder.setAuthentication(
+            PendingIntent.getActivity(
+                this,
+                PENDING_INTENT_REQUEST_CODE,
+                auth,
+                PendingIntent.FLAG_MUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            ).intentSender,
+        )
+        return builder.build()
+    }
+
+    private fun authIntent(target: Class<*>, fillTarget: FillTarget): Intent =
+        Intent(this, target).apply {
+            fillTarget.usernameId?.let { putExtra(EXTRA_USERNAME_ID, it) }
+            putExtra(EXTRA_PASSWORD_ID, fillTarget.passwordId)
+        }
+
+    companion object {
+        private const val TAG = "PeraAutofillService"
+        private const val PENDING_INTENT_REQUEST_CODE = 0
+
+        const val EXTRA_RECORD_ID = "co.algorand.passkeyautofill.RECORD_ID"
+        const val EXTRA_USERNAME_ID = "co.algorand.passkeyautofill.USERNAME_ID"
+        const val EXTRA_PASSWORD_ID = "co.algorand.passkeyautofill.PASSWORD_ID"
+        const val EXTRA_PACKAGE_NAME = "co.algorand.passkeyautofill.PACKAGE_NAME"
+        const val EXTRA_WEB_HOST = "co.algorand.passkeyautofill.WEB_HOST"
+    }
+}
