+package com.algorand.android.credentials.passkeys.ui
+
+import android.os.Build
+import androidx.annotation.RequiresApi
+import co.algorand.passkeyautofill.service.PasskeyAutofillCredentialProviderService
+
+/**
+ * PERA LOCAL PATCH — migration compatibility shim.
+ *
+ * The legacy native pera-android app registered its Credential Manager provider
+ * as `com.algorand.android/com.algorand.android.credentials.passkeys.ui.PasskeyProviderService`.
+ * Android persists the user's enabled provider by that exact ComponentName, so
+ * after the in-place native -> RN upgrade the provider selection is only
+ * retained if a service still resolves at this fully-qualified name.
+ *
+ * This subclass adds no behaviour; it exists purely so the manifest can declare
+ * the legacy ComponentName while all logic stays in the upstream base class.
+ * `ReactNativePasskeyAutofillModule` checks this same class for its
+ * `isProviderActive` / `openProviderSettings` ComponentName.
+ *
+ * Remove this shim (and the accompanying module patch) only once every user has
+ * migrated off the legacy native app.
+ */
+@RequiresApi(Build.VERSION_CODES.UPSIDE_DOWN_CAKE)
+class PasskeyProviderService : PasskeyAutofillCredentialProviderService()
