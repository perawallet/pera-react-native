@@ -0,0 +1,96 @@
+package co.algorand.passkeyautofill.autofill
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Locks the offer rules. `resolve` needs a `Context` and a real
+ * `AssistStructure`, so it belongs to the on-device checks; what a resolved
+ * scope will *hand out* is pure, and that is the half that leaks logins.
+ */
+class AutofillScopeTest {
+    private val record = "pera.login.abc"
+
+    @Test
+    fun `a verified browser is offered a login stored for its host`() {
+        val scope = AutofillScope.Web("example.com")
+        assertTrue(scope.matches("example.com", record))
+    }
+
+    @Test
+    fun `a verified browser is not offered a login stored for another host`() {
+        val scope = AutofillScope.Web("evil.com")
+        assertFalse(scope.matches("example.com", record))
+    }
+
+    @Test
+    fun `a browser with no resolvable host is offered nothing`() {
+        // The scope exists so a verified browser can never land in LinkedApp,
+        // whose match would then answer on every page the browser renders.
+        val scope = AutofillScope.UnscopedBrowser("com.android.chrome")
+        assertFalse(scope.matches("example.com", record))
+    }
+
+    @Test
+    fun `a linked app is offered only the logins it was linked to`() {
+        assertTrue(
+            AutofillScope.LinkedApp("com.example.app", null, setOf(record))
+                .matches("example.com", record),
+        )
+        assertFalse(
+            AutofillScope.LinkedApp("com.example.app", null, setOf("pera.login.other"))
+                .matches("example.com", record),
+        )
+    }
+
+    @Test
+    fun `an unlinked app is offered nothing`() {
+        val scope = AutofillScope.UnlinkedApp("com.example.app", null)
+        assertFalse(scope.matches("example.com", record))
+    }
+
+    @Test
+    fun `an app scope ignores the domain entirely`() {
+        // A caller that claimed a domain but failed the browser check reaches
+        // app scope; the claim must buy it nothing without a picked link.
+        val scope = AutofillScope.UnlinkedApp("com.example.app", "example.com")
+        assertFalse(scope.matches("example.com", record))
+    }
+
+    @Test
+    fun `a link asserted on one page does not answer on another page of the same app`() {
+        // The offer a web-rendering caller gets is the link store's answer for
+        // its own key. An app that renders web content — an in-app browser, or
+        // a real browser missing from the allowlist — must not carry a login
+        // asserted on its bank page over to the next origin it renders.
+        val linkedOnBank = AppLinkStore.linkKey("com.example.browser", "bank.example")
+        val phishing = AppLinkStore.linkKey("com.example.browser", "phish.example")
+        assertNotEquals(linkedOnBank, phishing)
+
+        // What resolve() would build for each: links come from the caller's own
+        // key, so the phishing page's scope is handed an empty set.
+        val onBank = AutofillScope.LinkedApp("com.example.browser", "bank.example", setOf(record))
+        val onPhishing = AutofillScope.UnlinkedApp("com.example.browser", "phish.example")
+        assertTrue(onBank.matches("bank.example", record))
+        assertFalse(onPhishing.matches("bank.example", record))
+    }
+
+    @Test
+    fun `a caller that claimed no domain stays keyed on its package alone`() {
+        // An ordinary native app has one identity, and that is the case the
+        // user-asserted link was designed for.
+        assertEquals("com.example.app", AppLinkStore.linkKey("com.example.app", null))
+        assertEquals("com.example.app", AppLinkStore.linkKey("com.example.app", ""))
+    }
+
+    @Test
+    fun `a host-keyed link never collides with the package-only key`() {
+        assertNotEquals(
+            AppLinkStore.linkKey("com.example.app", null),
+            AppLinkStore.linkKey("com.example.app", "example.com"),
+        )
+    }
+}
