+    emptyMessage: String,
+    cancelIfEmpty: Bool = false
+  ) {
+    let requested = serviceIdentifiers.map { $0.identifier }
+    offeredLogins = passwordStore?.loginSummaries(serviceIdentifiers: requested) ?? []
+    store?.appendDiagnostic("offering logins: \(offeredLogins.count)")
+    if cancelIfEmpty, offeredLogins.isEmpty {
+      cancel(code: .credentialIdentityNotFound, message: emptyMessage)
+      return
+    }
+    showLoginPicker(emptyMessage: emptyMessage)
+  }
