@@ -0,0 +1,123 @@
+package co.algorand.passkeyautofill.autofill
+
+import android.content.Context
+import android.os.Build
+import android.util.Log
+import androidx.annotation.RequiresApi
+import co.algorand.passkeyautofill.PasswordCredentialStore
+import co.algorand.passkeyautofill.PrivilegedBrowsers
+
+/**
+ * PERA LOCAL PATCH — who an `AutofillService` request is really for.
+ *
+ * The autofill counterpart to `PasswordCallerScope`, which answers the same
+ * question for a Credential Manager request. They stay separate because the two
+ * paths are given different evidence: Credential Manager supplies a
+ * `CallingAppInfo` carrying an origin the platform populated, while autofill
+ * supplies a view structure the client app filled in itself. The verification
+ * therefore differs even though the conclusion has the same shape.
+ */
+sealed class AutofillScope {
+    /**
+     * A caller whose signing certificate matched the browser allowlist, acting
+     * for a page on [host] over a secure scheme. The only scope that may be
+     * handed login entries without the user first naming them.
+     */
+    data class Web(val host: String) : AutofillScope()
+
+    /**
+     * A caller the user has already chosen logins for, on the [host] it claimed
+     * (null when it claimed none). [links] are the associations recorded under
+     * exactly this caller's key, read once by [resolve] — a second read
+     * elsewhere could use a different key and undo the host scoping.
+     */
+    data class LinkedApp(
+        val packageName: String,
+        val host: String?,
+        val links: Set<String>,
+    ) : AutofillScope()
+
+    /**
+     * A caller with no links yet for what it claimed to be, including any
+     * caller that claimed a domain but could not be identified as a browser.
+     * Offered a picker, never entries.
+     */
+    data class UnlinkedApp(val packageName: String, val host: String?) : AutofillScope()
+
+    /**
+     * An allowlisted browser whose request carried no host we could trust — no
+     * resolvable domain, or one claimed over an insecure scheme.
+     * **Matches nothing, and must never be offered the linking picker.**
+     *
+     * A browser link would have to be keyed on the browser package with no host
+     * to qualify it, attaching the login to *every* page that browser renders —
+     * the exact domain-blind offer [Web] exists to prevent. The caller is
+     * verified but the page is unknown, and an unknown page earns nothing.
+     */
+    data class UnscopedBrowser(val packageName: String) : AutofillScope()
+
+    /** Whether a login may be offered to this caller without being picked first. */
+    fun matches(storedDomain: String, recordIdentifier: String): Boolean =
+        when (this) {
+            is Web -> PasswordCredentialStore.domainMatches(storedDomain, host)
+            is LinkedApp -> links.contains(recordIdentifier)
+            is UnlinkedApp -> false
+            is UnscopedBrowser -> false
+        }
+
+    companion object {
+        private const val TAG = "AutofillScope"
+        private const val INSECURE_SCHEME = "http"
+
+        @RequiresApi(Build.VERSION_CODES.O)
+        fun resolve(context: Context, target: FillTarget): AutofillScope {
+            val host = target.webDomain
+                ?.let { PasswordCredentialStore.host(it) }
+                ?.takeIf { it.isNotEmpty() }
+
+            // Browser identity is settled before the domain is looked at, so a
+            // verified browser can never fall into app scope: a browser link
+            // could only be keyed on the browser itself, and would then answer
+            // on every page it renders.
+            if (PrivilegedBrowsers.isAllowlistedBrowser(context, target.packageName)) {
+                return if (host == null || isInsecure(target.webScheme)) {
+                    UnscopedBrowser(target.packageName)
+                } else {
+                    Web(host)
+                }
+            }
+
+            // An unverified caller falls through to app scope rather than being
+            // denied outright — it may well be honest, and the picker puts the
+            // choice to the user instead of to the claim. The claim still binds
+            // the link it can create: an honest in-app browser reports the page
+            // it is on, so scoping to that page stops a login asserted on one
+            // origin being offered on the next one the same app renders.
+            val links: Set<String> = try {
+                AppLinkStore.linksFor(context, target.packageName, host)
+            } catch (e: Exception) {
+                // Fail to the picker, not to a match.
+                Log.w(TAG, "Could not read app links for ${target.packageName}", e)
+                emptySet()
+            }
+            return if (links.isEmpty()) {
+                UnlinkedApp(target.packageName, host)
+            } else {
+                LinkedApp(target.packageName, host, links)
+            }
+        }
+
+        /**
+         * An `http` page is attacker-writable in transit, so a credential
+         * released to one leaks to whoever is on the path — even inside a fully
+         * verified browser.
+         *
+         * `ViewNode.getWebScheme()` only exists from API 28, and the parser
+         * reports null below it. Unknown is treated as allowed: the alternative
+         * withdraws web fill entirely from API 26 and 27, which is a larger
+         * regression than the narrow case it would close.
+         */
+        private fun isInsecure(scheme: String?): Boolean =
+            scheme?.equals(INSECURE_SCHEME, ignoreCase = true) == true
+    }
+}
