index 0000000000000000000000000000000000000000..452ead69fc9c4ab167c1e642d4c3838b2481b115
--- /dev/null
+++ b/android/src/main/java/co/algorand/passkeyautofill/GetPasswordActivity.kt
@@ -0,0 +1,200 @@
+package co.algorand.passkeyautofill
+
+import android.app.Activity
+import android.content.Intent
+import android.os.Build
+import android.os.Bundle
+import android.util.Log
+import androidx.annotation.RequiresApi
+import androidx.appcompat.app.AppCompatActivity
+import androidx.biometric.BiometricPrompt
+import androidx.core.content.ContextCompat
+import androidx.credentials.GetCredentialResponse
+import androidx.credentials.PasswordCredential
+import androidx.credentials.exceptions.GetCredentialCancellationException
+import androidx.credentials.exceptions.GetCredentialException
+import androidx.credentials.exceptions.GetCredentialUnknownException
+import androidx.credentials.provider.PendingIntentHandler
+import androidx.credentials.provider.ProviderGetCredentialRequest
+import androidx.lifecycle.lifecycleScope
+import co.algorand.passkeyautofill.auth.BiometricRequirement
+import kotlin.coroutines.resume
+import kotlin.coroutines.suspendCoroutine
+import kotlinx.coroutines.launch
+
+/**
+ * PERA LOCAL PATCH — releases one saved password to the caller that selected
+ * its entry.
+ *
+ * The provider's entry list carries a login id and its host (see
+ * [EXTRA_LOGIN_HOST]) but never a password, so this activity re-checks the
+ * caller's scope against that host, gates on biometrics, and only then calls
+ * [PasswordCredentialStore.login] to unseal the selected record. That call is
+ * this activity's only unseal, and it happens after biometrics succeeds.
+ * Building the provider's entry list is a separate step, in the service, and
+ * does unseal every matching login's material once to read its host and
+ * username — see [PasswordCallerScope] and
+ * [PasswordCredentialStore.loginSummaries] for why.
+ *
+ * Unlike [GetPasskeyActivity] this shows no UI of its own — the biometric
+ * prompt is the only thing the user sees, and a failure is reported to the
+ * caller rather than rendered, so there is no window in which a decrypted
+ * password is sitting behind a screen the user can dismiss.
+ */
+@RequiresApi(Build.VERSION_CODES.UPSIDE_DOWN_CAKE)
+class GetPasswordActivity : AppCompatActivity() {
+    private val passwordStore = PasswordCredentialStore()
+
+    companion object {
+        const val TAG = "GetPasswordActivity"
+
+        /** Key inside the PendingIntent's `CREDENTIAL_DATA` bundle. */
+        const val EXTRA_LOGIN_ID = "loginId"
+
+        /**
+         * Key inside the PendingIntent's `CREDENTIAL_DATA` bundle for the
+         * login's comparable host (see [PasswordCredentialStore.host]).
+         *
+         * `CREDENTIAL_DATA` is written by the service when it builds the
+         * entry, and [Intent.fillIn] cannot replace an existing extra, so a
+         * caller cannot substitute its own host here. Carrying it lets this
+         * activity re-check the caller's scope without unsealing the login a
+         * second time before biometrics.
+         */
+        const val EXTRA_LOGIN_HOST = "loginHost"
+    }
+
+    private var isHandling: Boolean = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        handleRelease()
+    }
+
+    private fun handleRelease() {
+        if (isHandling) return
+        isHandling = true
+
+        val request: ProviderGetCredentialRequest? = try {
+            PendingIntentHandler.retrieveProviderGetCredentialRequest(intent)
+        } catch (e: Exception) {
+            Log.e(TAG, "Error retrieving request from intent", e)
+            null
+        }
+        if (request == null) {
+            fail(GetCredentialUnknownException("The password request could not be read."))
+            return
+        }
+
+        val credentialData = intent.getBundleExtra("CREDENTIAL_DATA")
+        val loginId = credentialData?.getString(EXTRA_LOGIN_ID)
+        if (loginId.isNullOrEmpty()) {
+            fail(GetCredentialUnknownException("The password request named no login."))
+            return
+        }
+        val loginHost = credentialData.getString(EXTRA_LOGIN_HOST)
+
+        // Defence in depth. The login is selected purely by the id carried in
+        // the PendingIntent, so re-apply the provider's own scoping rule here
+        // rather than trusting that the query-time filter was the only way to
+        // reach this point. Mirrors GetPasskeyActivity's origin re-check.
+        //
+        // Matched against the host carried in CREDENTIAL_DATA, not against a
+        // freshly unsealed record: this activity must not unseal anything
+        // before biometrics succeed.
+        val callerScope = PasswordCallerScope.resolve(this, request.callingAppInfo)
+        if (callerScope == null || loginHost.isNullOrEmpty() || !callerScope.matches(loginHost)) {
+            Log.e(TAG, "Refusing release: the selected login does not belong to the requester")
+            fail(GetCredentialUnknownException("This login is not available to the requesting app."))
+            return
+        }
+
+        lifecycleScope.launch {
+            val authenticated = biometrics()
+            if (!authenticated) {
+                Log.w(TAG, "Biometrics failed or was canceled; releasing nothing")
+                fail(GetCredentialCancellationException("Authentication was canceled."))
+                return@launch
+            }
+
+            val login = passwordStore.login(this@GetPasswordActivity, loginId)
+            if (login == null) {
+                Log.e(TAG, "The selected login could not be opened")
+                fail(GetCredentialUnknownException("This login could not be read."))
+                return@launch
+            }
+            // PasswordCredential rejects an empty password, so a record that
+            // somehow holds one is reported rather than thrown out of the
+            // coroutine, which would leave the caller waiting on a dead intent.
+            if (login.password.isEmpty()) {
+                Log.e(TAG, "The selected login has no password to release")
+                fail(GetCredentialUnknownException("This login has no password saved."))
+                return@launch
+            }
+
+            val resultIntent = Intent()
+            PendingIntentHandler.setGetCredentialResponse(
+                resultIntent,
+                GetCredentialResponse(PasswordCredential(login.username, login.password))
+            )
+            setResult(Activity.RESULT_OK, resultIntent)
+            finish()
+        }
+    }
+
+    /**
+     * The same prompt shape [GetPasskeyActivity] uses, honouring the build-time
+     * configured [BiometricRequirement].
+     *
+     * No `CryptoObject` is passed: a login is sealed with the wallet's master
+     * key, not with a user-auth-bound Keystore key, so this gate is enforced by
+     * the ordering in [handleRelease] rather than cryptographically — the same
+     * situation as a `WEAK_OR_CREDENTIAL` passkey.
+     */
+    private suspend fun biometrics(): Boolean {
+        val requirement = BiometricRequirement.resolve(this)
+        return suspendCoroutine { continuation ->
+            val biometricPrompt = BiometricPrompt(
+                this,
+                ContextCompat.getMainExecutor(this),
+                object : BiometricPrompt.AuthenticationCallback() {
+                    override fun onAuthenticationSucceeded(result: BiometricPrompt.AuthenticationResult) {
+                        super.onAuthenticationSucceeded(result)
+                        continuation.resume(true)
+                    }
+
+                    override fun onAuthenticationError(errorCode: Int, errString: CharSequence) {
+                        super.onAuthenticationError(errorCode, errString)
+                        continuation.resume(false)
+                    }
+
+                    override fun onAuthenticationFailed() {
+                        super.onAuthenticationFailed()
+                    }
+                }
+            )
+            val promptInfoBuilder = BiometricPrompt.PromptInfo.Builder()
+                .setTitle("Use saved login")
+                .setSubtitle("Authenticate to fill your password")
+                .setAllowedAuthenticators(requirement.allowedAuthenticators)
+            if (!requirement.allowsDeviceCredential) {
+                promptInfoBuilder.setNegativeButtonText("Cancel")
+            }
+            biometricPrompt.authenticate(promptInfoBuilder.build())
+        }
+    }
+
+    /**
+     * Reports a failure to the caller and releases nothing.
+     *
+     * `RESULT_OK` with an exception set is how AndroidX carries a provider
+     * error back: `RESULT_CANCELED` would be read as the user dismissing the
+     * system UI and loses the reason.
+     */
+    private fun fail(exception: GetCredentialException) {
+        val resultIntent = Intent()
+        PendingIntentHandler.setGetCredentialException(resultIntent, exception)
+        setResult(Activity.RESULT_OK, resultIntent)
+        finish()
+    }
+}
