diff --git a/ios/AutofillCredentialProvider/PasswordCredentialStore.swift b/ios/AutofillCredentialProvider/PasswordCredentialStore.swift
new file mode 100644
index 0000000000000000000000000000000000000000..f05ed731ac4ab07703691d778c22953d28c33692
--- /dev/null
+++ b/ios/AutofillCredentialProvider/PasswordCredentialStore.swift
@@ -0,0 +1,234 @@
+import Foundation
+
+/// A login the wallet sealed into the shared keystore.
+///
+/// `password` is the reason this type exists, so treat an instance as secret:
+/// build one only to answer a request that has already been user-verified, and
+/// never write one into diagnostics or UserDefaults.
+struct StoredLogin {
+  /// The keystore record id (`pera.login.<uuid>`), which is also the
+  /// `recordIdentifier` published to the OS credential index.
+  let recordIdentifier: String
+  let domain: String
+  let username: String
+  let password: String
+  let note: String?
+  /// Epoch **milliseconds**, as the wallet writes them.
+  let createdAt: Double
+  let updatedAt: Double
+}
+
+/// What a login can say about itself without its secret: enough to list it,
+/// match it against a request and publish it to the OS index.
+///
+/// Every bulk read returns these. `StoredLogin` — the only shape carrying the
+/// password — is reachable one record at a time, so nothing can hold a set of
+/// decrypted passwords.
+struct LoginSummary {
+  let recordIdentifier: String
+  /// The stored domain reduced to a comparable host, e.g. `example.com`.
+  let host: String
+  let username: String
+}
+
+/// Reads the wallet's logins out of the keystore records shared through the App
+/// Group, using the same master key and envelope handling as the passkey store.
+///
+/// Nothing here writes: the wallet owns the record lifecycle, and the extension
+/// is a reader that answers `ASPasswordCredentialRequest`.
+final class PasswordCredentialStore {
+  /// Plaintext discriminator the wallet writes into `k/<id>` metadata. Logins
+  /// share the canonical `secret-key` record type with the hashed PIN, the
+  /// mirrored biometric blob and the card session tokens, so the record type
+  /// cannot tell them apart — this is what does.
+  static let loginKind = "login"
+
+  /// The only sealed-payload version this build understands. A record from a
+  /// newer wallet is skipped rather than guessed at.
+  static let payloadVersion = 1
+
+  private let appGroup: String
+  private let secrets: KeystoreSecretReader
+
+  init?(
+    appGroup: String? = KeystoreSecretReader.appGroupFromInfoPlist()
+  ) {
+    guard let appGroup, let defaults = UserDefaults(suiteName: appGroup) else {
+      return nil
+    }
+    self.appGroup = appGroup
+    self.secrets = KeystoreSecretReader(defaults: defaults)
+  }
+
+  /// Every login, as summaries. The sealed payload is decoded to read the
+  /// domain and username — they live inside it — but the password is never
+  /// bound, so none is retained past this call.
+  func loginSummaries() -> [LoginSummary] {
+    guard let masterKey = secrets.masterKey() else {
+      return []
+    }
+    return secrets.recordIds(appGroup: appGroup)
+      .compactMap { summary(recordIdentifier: $0, masterKey: masterKey) }
+      .sorted { $0.host.localizedCaseInsensitiveCompare($1.host) == .orderedAscending }
+  }
+
+  /// The logins offered for a request, matched on the domain.
+  ///
+  /// An empty `serviceIdentifiers` means the system named no site (the user
+  /// opened the provider directly), so every login is a candidate.
+  func loginSummaries(serviceIdentifiers: [String]) -> [LoginSummary] {
+    guard !serviceIdentifiers.isEmpty else {
+      return loginSummaries()
+    }
+    let requested = serviceIdentifiers.map { Self.host(of: $0) }.filter { !$0.isEmpty }
+    guard !requested.isEmpty else {
+      return []
+    }
+    return loginSummaries().filter { login in
+      requested.contains { Self.domain(login.host, matches: $0) }
+    }
+  }
+
+  /// The one way to reach a password, one record at a time. Call it when
+  /// something is about to use the secret — never to build a list.
+  func login(recordIdentifier: String) -> StoredLogin? {
+    guard let masterKey = secrets.masterKey() else {
+      return nil
+    }
+    return login(recordIdentifier: recordIdentifier, masterKey: masterKey)
+  }
+
+  private func summary(recordIdentifier: String, masterKey: Data) -> LoginSummary? {
+    guard let payload = loginPayload(recordIdentifier: recordIdentifier, masterKey: masterKey) else {
+      return nil
+    }
+    return Self.decodeSummary(payload: payload, recordIdentifier: recordIdentifier)
+  }
+
+  private func login(recordIdentifier: String, masterKey: Data) -> StoredLogin? {
+    guard let payload = loginPayload(recordIdentifier: recordIdentifier, masterKey: masterKey) else {
+      return nil
+    }
+    return Self.decode(payload: payload, recordIdentifier: recordIdentifier)
+  }
+
+  /// The sealed bytes of a login record, or `nil` when the record is not a login.
+  /// The `k/<id>` metadata is plaintext, so a non-login record is rejected
+  /// before anything is unsealed.
+  private func loginPayload(recordIdentifier: String, masterKey: Data) -> Data? {
+    guard let record = secrets.metadata(
+      of: recordIdentifier,
+      masterKey: masterKey,
+      appGroup: appGroup
+    ) else {
+      return nil
+    }
+    let metadata = record["metadata"] as? [String: Any]
+    let kind = metadata?["kind"] as? String ?? record["kind"] as? String
+    guard kind == Self.loginKind else {
+      return nil
+    }
+    return secrets.material(of: recordIdentifier, masterKey: masterKey, appGroup: appGroup)
+  }
+
+  /// Decodes the sealed payload the wallet's `encodeLoginPayload` writes: UTF-8
+  /// JSON, no envelope of its own.
+  static func decode(payload: Data, recordIdentifier: String) -> StoredLogin? {
+    guard let json = try? JSONSerialization.jsonObject(with: payload) as? [String: Any],
+          let version = json["v"] as? Int,
+          version == payloadVersion,
+          let domain = json["domain"] as? String,
+          let username = json["username"] as? String,
+          let password = json["password"] as? String,
+          let createdAt = json["createdAt"] as? Double,
+          let updatedAt = json["updatedAt"] as? Double
+    else {
+      return nil
+    }
+    return StoredLogin(
+      recordIdentifier: recordIdentifier,
+      domain: domain,
+      username: username,
+      password: password,
+      note: json["note"] as? String,
+      createdAt: createdAt,
+      updatedAt: updatedAt
+    )
+  }
+
+  /// The summary half of the payload. Deliberately does not bind `password`:
+  /// listing logins must not put a decrypted password into a variable that
+  /// outlives the parse.
+  ///
+  /// Mirrors `decode`'s shape check (password presence, `createdAt`/`updatedAt`)
+  /// so a malformed record is rejected the same way in both readers instead of
+  /// surfacing here and only failing later, at release, when `decode` is the
+  /// one called.
+  static func decodeSummary(payload: Data, recordIdentifier: String) -> LoginSummary? {
+    guard let json = try? JSONSerialization.jsonObject(with: payload) as? [String: Any],
+          let version = json["v"] as? Int,
+          version == payloadVersion,
+          let domain = json["domain"] as? String,
+          let username = json["username"] as? String,
+          json["password"] is String,
+          json["createdAt"] is Double,
+          json["updatedAt"] is Double
+    else {
+      return nil
+    }
+    let host = host(of: domain)
+    guard !host.isEmpty else {
+      return nil
+    }
+    return LoginSummary(recordIdentifier: recordIdentifier, host: host, username: username)
+  }
+
+  /// A stored `example.com` answers a request for `example.com` and for any
+  /// subdomain of it.
+  ///
+  /// The subdomain test requires the dot: a plain suffix check would hand
+  /// `example.com`'s password to `evil-example.com`, and matching anywhere in
+  /// the string would do it in both directions. It also requires the *stored*
+  /// host to contain a dot before it is allowed to match a subdomain — without
+  /// that, a login stored as the bare public-suffix label `com` would answer
+  /// every `*.com` site.
+  static func domain(_ stored: String, matches requestedHost: String) -> Bool {
+    let storedHost = host(of: stored)
+    guard !storedHost.isEmpty, !requestedHost.isEmpty else {
+      return false
+    }
+    if storedHost == requestedHost {
+      return true
+    }
+    guard storedHost.contains(".") else {
+      return false
+    }
+    return requestedHost.hasSuffix("." + storedHost)
+  }
+
+  /// The comparable host of a stored domain or of an `ASCredentialServiceIdentifier`.
+  ///
+  /// Service identifiers arrive as a bare host for `.domain` and as a full URL
+  /// for `.URL`, and a stored domain is whatever the user typed, so both sides
+  /// are reduced the same way: scheme, credentials, port, path and the root
+  /// label's trailing dot all dropped, then case-folded.
+  static func host(of identifier: String) -> String {
+    var value = identifier.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+    if let schemeEnd = value.range(of: "://") {
+      value = String(value[schemeEnd.upperBound...])
+    }
+    if let pathStart = value.firstIndex(where: { $0 == "/" || $0 == "?" || $0 == "#" }) {
+      value = String(value[..<pathStart])
+    }
+    if let credentialsEnd = value.lastIndex(of: "@") {
+      value = String(value[value.index(after: credentialsEnd)...])
+    }
+    if let portStart = value.lastIndex(of: ":"), !value.hasPrefix("[") {
+      value = String(value[..<portStart])
+    }
+    while value.hasSuffix(".") {
+      value.removeLast()
+    }
+    return value
+  }
+}
