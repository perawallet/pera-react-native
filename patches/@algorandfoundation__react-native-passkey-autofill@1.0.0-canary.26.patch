+++ b/android/src/test/java/co/algorand/passkeyautofill/PasswordDomainMatchingTest.kt
@@ -0,0 +1,50 @@
+package co.algorand.passkeyautofill
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * `AutofillScope.Web` decides what a browser is offered entirely through these
+ * two, so their edges are the feature's disclosure boundary.
+ */
+class PasswordDomainMatchingTest {
+    @Test
+    fun `a stored domain matches itself and its subdomains`() {
+        assertTrue(PasswordCredentialStore.domainMatches("example.com", "example.com"))
+        assertTrue(PasswordCredentialStore.domainMatches("example.com", "login.example.com"))
+        assertTrue(PasswordCredentialStore.domainMatches("example.com", "a.b.example.com"))
+    }
+
+    @Test
+    fun `a suffix that is not a subdomain does not match`() {
+        // The dot is what separates a subdomain from a lookalike registration.
+        assertFalse(PasswordCredentialStore.domainMatches("example.com", "evil-example.com"))
+        assertFalse(PasswordCredentialStore.domainMatches("example.com", "notexample.com"))
+    }
+
+    @Test
+    fun `matching does not run in the other direction`() {
+        assertFalse(PasswordCredentialStore.domainMatches("login.example.com", "example.com"))
+    }
+
+    @Test
+    fun `a bare public suffix does not answer for every site under it`() {
+        assertFalse(PasswordCredentialStore.domainMatches("com", "example.com"))
+    }
+
+    @Test
+    fun `an empty host on either side matches nothing`() {
+        assertFalse(PasswordCredentialStore.domainMatches("", "example.com"))
+        assertFalse(PasswordCredentialStore.domainMatches("example.com", ""))
+    }
+
+    @Test
+    fun `host reduces a url to a comparable host`() {
+        assertEquals("example.com", PasswordCredentialStore.host("https://example.com/login?a=b"))
+        assertEquals("example.com", PasswordCredentialStore.host("https://user@example.com:8443/"))
+        assertEquals("example.com", PasswordCredentialStore.host("EXAMPLE.COM."))
+        assertEquals("example.com", PasswordCredentialStore.host("  example.com  "))
+    }
+}
diff --git a/android/src/test/java/co/algorand/passkeyautofill/PrivilegedBrowsersTest.kt b/android/src/test/java/co/algorand/passkeyautofill/PrivilegedBrowsersTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..b457e5db0aa44c7e60b3f59cd80bb8b844134e8e
--- /dev/null
+++ b/android/src/test/java/co/algorand/passkeyautofill/PrivilegedBrowsersTest.kt
@@ -0,0 +1,154 @@
+package co.algorand.passkeyautofill
+
+import java.io.File
+import java.security.MessageDigest
+import java.util.Locale
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Guards the fingerprint comparison, which fails closed and silently: a spelling
+ * mismatch between the two sides makes every browser check return false, so no
+ * browser is ever offered a login while nothing anywhere reports an error.
+ */
+class PrivilegedBrowsersTest {
+    private val allowlistJson: String by lazy(::readShippedAllowlist)
+
+    private val chromeRelease =
+        "f0fd6c5b410f25cb25c3b53346c8972fae30f8ee7411df910480ad6b2d60db83"
+    private val chromeUserdebug =
+        "1975b2f17177bc89a5dff31f9e64a6cae281a53dc1d1d59b1d147fe1c82afa00"
+
+    @Test
+    fun `every shipped fingerprint normalizes to 64 lowercase hex characters`() {
+        val apps = JSONObject(allowlistJson).getJSONArray("apps")
+        var checked = 0
+        for (i in 0 until apps.length()) {
+            val info = apps.getJSONObject(i).getJSONObject("info")
+            val signatures = info.getJSONArray("signatures")
+            for (j in 0 until signatures.length()) {
+                val raw = signatures.getJSONObject(j).getString("cert_fingerprint_sha256")
+                val normalized = PrivilegedBrowsers.normalize(raw)
+                val where = "${info.getString("package_name")} signature $j"
+                assertEquals("$where is not 32 bytes", 64, normalized.length)
+                assertTrue(
+                    "$where is not lowercase hex: $normalized",
+                    normalized.all { it in '0'..'9' || it in 'a'..'f' },
+                )
+                checked++
+            }
+        }
+        // The allowlist is a shipped asset; an empty walk would pass vacuously.
+        assertTrue("no fingerprints found in the shipped allowlist", checked > 0)
+    }
+
+    @Test
+    fun `toHex renders bytes as lowercase hex without sign extension`() {
+        // Kotlin's Byte is signed, so the high-bit values are the ones that
+        // break a naive conversion.
+        val bytes = byteArrayOf(0x00, 0x0F, 0x10, 0x7F, 0x80.toByte(), 0xF0.toByte(), 0xFF.toByte())
+        assertEquals("000f107f80f0ff", PrivilegedBrowsers.toHex(bytes))
+    }
+
+    @Test
+    fun `toHex of a DER digest matches the allowlist spelling of the same value`() {
+        // Both sides of the real comparison, met on a real allowlist entry: the
+        // allowlist value stripped and lowercased, against the digest-side
+        // rendering of the very same bytes.
+        val der = "MIIDATCCAemgAwIBAgIEXAMPLE".toByteArray()
+        val digest = MessageDigest.getInstance("SHA-256").digest(der)
+        val computed = PrivilegedBrowsers.toHex(digest)
+        assertEquals(64, computed.length)
+
+        // Locale.ROOT for the same reason production builds hex by hand: a
+        // digit-shaping default locale would otherwise rewrite the expectation.
+        val asAllowlistWouldWrite = digest.joinToString(":") { "%02X".format(Locale.ROOT, it) }
+        assertEquals(computed, PrivilegedBrowsers.normalize(asAllowlistWouldWrite))
+    }
+
+    @Test
+    fun `chrome resolves to its release fingerprint off a userdebug build`() {
+        val fingerprints = PrivilegedBrowsers.parseAllowlistFingerprints(
+            allowlistJson,
+            "com.android.chrome",
+            acceptUserdebugSignatures = false,
+        )
+        assertEquals(setOf(chromeRelease), fingerprints)
+    }
+
+    @Test
+    fun `chrome gains its userdebug fingerprint on a userdebug build`() {
+        val fingerprints = PrivilegedBrowsers.parseAllowlistFingerprints(
+            allowlistJson,
+            "com.android.chrome",
+            acceptUserdebugSignatures = true,
+        )
+        assertEquals(setOf(chromeRelease, chromeUserdebug), fingerprints)
+    }
+
+    @Test
+    fun `a package absent from the allowlist gets no fingerprints`() {
+        // isAllowlistedBrowser treats an empty set as "not a browser", so this
+        // is what stops an arbitrary app from passing the check vacuously.
+        val fingerprints = PrivilegedBrowsers.parseAllowlistFingerprints(
+            allowlistJson,
+            "com.example.not.a.browser",
+            acceptUserdebugSignatures = true,
+        )
+        assertTrue(fingerprints.isEmpty())
+    }
+
+    @Test
+    fun `a debug-only browser is unreachable off a userdebug build`() {
+        // Firefox's webauthndebug build ships userdebug signatures only.
+        val fingerprints = PrivilegedBrowsers.parseAllowlistFingerprints(
+            allowlistJson,
+            "org.mozilla.fennec_webauthndebug",
+            acceptUserdebugSignatures = false,
+        )
+        assertTrue(fingerprints.isEmpty())
+    }
+
+    @Test
+    fun `unparseable allowlist json yields no fingerprints rather than throwing`() {
+        // The parse must fail closed by itself. Relying on isAllowlistedBrowser's
+        // outer catch would make this property invisible at the point that owns
+        // it, and it would vanish the moment anything else called this directly.
+        for (unparseable in listOf("{", "not json", "", "[", """{"apps": [""")) {
+            val fingerprints = PrivilegedBrowsers.parseAllowlistFingerprints(
+                unparseable,
+                "com.android.chrome",
+                acceptUserdebugSignatures = false,
+            )
+            assertTrue("expected no fingerprints from <$unparseable>", fingerprints.isEmpty())
+        }
+    }
+
+    @Test
+    fun `allowlist json without an apps key yields no fingerprints`() {
+        // Valid JSON, wrong shape — a different path from unparseable input.
+        assertTrue(
+            PrivilegedBrowsers.parseAllowlistFingerprints(
+                """{"unexpected": true}""",
+                "com.android.chrome",
+                acceptUserdebugSignatures = false,
+            ).isEmpty(),
+        )
+    }
+
+    private fun readShippedAllowlist(): String {
+        var directory: File? = File(System.getProperty("user.dir") ?: ".").absoluteFile
+        while (directory != null) {
+            val candidate = File(directory, RESOURCE_PATH)
+            if (candidate.isFile) return candidate.readText()
+            directory = directory.parentFile
+        }
+        throw AssertionError("could not find $RESOURCE_PATH from ${System.getProperty("user.dir")}")
+    }
+
+    private companion object {
+        const val RESOURCE_PATH = "src/main/res/raw/passkey_privileged_browsers.json"
+    }
+}
