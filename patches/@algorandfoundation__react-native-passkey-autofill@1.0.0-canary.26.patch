+package co.algorand.passkeyautofill.autofill
+
+import android.os.Build
+import android.os.Bundle
+import android.util.Log
+import android.view.autofill.AutofillId
+import android.widget.ArrayAdapter
+import android.widget.ListView
+import android.widget.TextView
+import androidx.annotation.RequiresApi
+import androidx.appcompat.app.AppCompatActivity
+import androidx.lifecycle.lifecycleScope
+import co.algorand.passkeyautofill.LoginSummary
+import co.algorand.passkeyautofill.PasswordCredentialStore
+import co.algorand.passkeyautofill.R
+import kotlinx.coroutines.launch
+
+/**
+ * PERA LOCAL PATCH — the dataset-auth target for a caller with no linked login
+ * ([PeraAutofillService.pickerResponse]). Android cannot verify that a package
+ * legitimately represents the domain the user is signing into (no Digital Asset
+ * Links here), so the user picking a login from a screen that names the
+ * requesting app IS the verification step. That makes the identity this screen
+ * shows load-bearing — see [callerText].
+ *
+ * The chosen login is released and [AppLinkStore.link] is written only after
+ * [biometrics] succeeds — mirroring [FillAuthActivity]'s ordering — so a
+ * cancelled prompt leaves no association behind.
+ */
+@RequiresApi(Build.VERSION_CODES.O)
+class PeraPickerActivity : AppCompatActivity() {
+
+    private val store = PasswordCredentialStore()
+
+    /**
+     * Guards the item-click path: without it, a double tap on a list row
+     * could fire two biometric prompts, or write the link and release the
+     * dataset twice. Mirrors [FillAuthActivity.isHandling].
+     */
+    private var isHandling: Boolean = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.pera_autofill_picker)
+
+        val callerPackageName = intent.getStringExtra(PeraAutofillService.EXTRA_PACKAGE_NAME)
+        // Absent when the caller claimed no domain, which is the ordinary
+        // native-app case and stays linked on the package alone.
+        val callerHost = intent.getStringExtra(PeraAutofillService.EXTRA_WEB_HOST)
+        val passwordId = intent.parcelable<AutofillId>(PeraAutofillService.EXTRA_PASSWORD_ID)
+        val usernameId = intent.parcelable<AutofillId>(PeraAutofillService.EXTRA_USERNAME_ID)
+        if (callerPackageName == null || passwordId == null) {
+            Log.e(TAG, "Missing required extras on the picker intent")
+            cancel()
+            return
+        }
+
+        // The user is the only thing standing between this app and a login, so
+        // they must be able to see which app is asking before they choose.
+        findViewById<TextView>(R.id.pera_autofill_picker_caller).text =
+            callerText(callerPackageName)
+
+        val summaries = store.loginSummaries(this)
+        findViewById<ListView>(R.id.pera_autofill_picker_list).apply {
+            adapter = ArrayAdapter(
+                this@PeraPickerActivity,
+                android.R.layout.simple_list_item_1,
+                summaries.map { "${it.username} — ${it.host}" },
+            )
+            setOnItemClickListener { _, _, position, _ ->
+                if (isHandling) return@setOnItemClickListener
+                isHandling = true
+                val chosen = summaries[position]
+                lifecycleScope.launch {
+                    release(callerPackageName, callerHost, chosen, usernameId, passwordId)
+                }
+            }
+        }
+    }
+
+    private suspend fun release(
+        callerPackageName: String,
+        callerHost: String?,
+        chosen: LoginSummary,
+        usernameId: AutofillId?,
+        passwordId: AutofillId,
+    ) {
+        if (!biometrics()) { cancel(); return }
+
+        val login = try {
+            store.login(this, chosen.recordIdentifier)
+        } catch (e: Exception) {
+            Log.e(TAG, "Unseal failed", e)
+            null
+        }
+        if (login == null) { cancel(); return }
+        // Mirrors FillAuthActivity's guard: an empty password would otherwise
+        // fill a real username alongside nothing, which is the partial fill
+        // this feature must never produce.
+        if (login.password.isEmpty()) {
+            Log.e(TAG, "The selected login has no password to release")
+            cancel()
+            return
+        }
+
+        // Only after the prompt succeeds: a cancelled prompt must leave no
+        // association behind.
+        AppLinkStore.link(this, callerPackageName, callerHost, chosen.recordIdentifier)
+
+        finishWith(
+            buildDataset(usernameId, passwordId, login.username, login.password, packageName),
+        )
+    }
+
+    /**
+     * Names the caller by its package, with its label alongside when one
+     * resolves.
+     *
+     * The label comes from the caller's own manifest, so an app can ship
+     * `android:label="mybank.com"` and have this screen read as the bank's. The
+     * package name is assigned at install time and is the only identity here
+     * the caller does not choose, so it is always shown; the label is a
+     * convenience shown with it, never instead of it.
+     */
+    private fun callerText(packageName: String): String {
+        val label = appLabel(packageName)
+        return if (label == null) {
+            getString(R.string.pera_autofill_picker_caller, packageName)
+        } else {
+            getString(R.string.pera_autofill_picker_caller_labelled, label, packageName)
+        }
+    }
+
+    /**
+     * Null when the label is unresolvable, which under Android 11 package
+     * visibility is the common case: a package this app does not declare in
+     * `<queries>` is simply not visible to `PackageManager`.
+     */
+    private fun appLabel(packageName: String): String? = try {
+        val info = packageManager.getApplicationInfo(packageName, 0)
+        packageManager.getApplicationLabel(info).toString().takeIf {
+            it.isNotBlank() && it != packageName
+        }
+    } catch (e: Exception) {
+        null
+    }
+
+    companion object {
+        private const val TAG = "PeraPickerActivity"
+    }
+}
