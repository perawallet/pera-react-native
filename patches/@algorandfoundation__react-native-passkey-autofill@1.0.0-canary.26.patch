@@ -0,0 +1,75 @@
+package co.algorand.passkeyautofill.autofill
+
+import android.os.Build
+import android.os.Bundle
+import android.util.Log
+import android.view.autofill.AutofillId
+import androidx.annotation.RequiresApi
+import androidx.appcompat.app.AppCompatActivity
+import androidx.lifecycle.lifecycleScope
+import co.algorand.passkeyautofill.PasswordCredentialStore
+import kotlinx.coroutines.launch
+
+/**
+ * PERA LOCAL PATCH — the dataset-auth target for a matched login
+ * ([PeraAutofillService.matchedResponse]), and the point where a decrypted
+ * password is actually released to the platform.
+ *
+ * Biometrics gate the unseal, not the other way round: [PasswordCredentialStore.login]
+ * is called only after [biometrics] succeeds, mirroring `GetPasswordActivity`'s
+ * ordering on the Credential Manager side. On cancellation, biometric failure,
+ * or a failed unseal, nothing fills — see [cancel].
+ */
+@RequiresApi(Build.VERSION_CODES.O)
+class FillAuthActivity : AppCompatActivity() {
+
+    private val store = PasswordCredentialStore()
+
+    /**
+     * Guards against [onCreate] running a second time (e.g. a config change)
+     * before the first [release] finishes — without it, a re-entrant call
+     * could show a second biometric prompt or unseal and finish twice.
+     * Mirrors `GetPasswordActivity.isHandling`.
+     */
+    private var isHandling: Boolean = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        if (isHandling) return
+        isHandling = true
+        lifecycleScope.launch { release() }
+    }
+
+    private suspend fun release() {
+        val recordId = intent.getStringExtra(PeraAutofillService.EXTRA_RECORD_ID)
+        val passwordId = intent.parcelable<AutofillId>(PeraAutofillService.EXTRA_PASSWORD_ID)
+        val usernameId = intent.parcelable<AutofillId>(PeraAutofillService.EXTRA_USERNAME_ID)
+
+        if (recordId == null || passwordId == null) { cancel(); return }
+        if (!biometrics()) { cancel(); return }
+
+        val login = try {
+            store.login(this, recordId)
+        } catch (e: Exception) {
+            Log.e(TAG, "Unseal failed", e)
+            null
+        }
+        if (login == null) { cancel(); return }
+        // PasswordCredentialStore.decode only rejects a JSON-null/missing
+        // password key, not an explicitly-stored empty string. Mirrors
+        // GetPasswordActivity's guard: an empty password would otherwise fill
+        // a real username alongside nothing, which is the partial fill this
+        // feature must never produce.
+        if (login.password.isEmpty()) {
+            Log.e(TAG, "The selected login has no password to release")
+            cancel()
+            return
+        }
+
+        finishWith(buildDataset(usernameId, passwordId, login.username, login.password, packageName))
+    }
+
+    companion object {
+        private const val TAG = "FillAuthActivity"
+    }
+}
