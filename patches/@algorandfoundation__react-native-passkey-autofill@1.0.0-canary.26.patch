+
+/**
+ * PERA LOCAL PATCH: the React component the picker activity mounts.
+ *
+ * Written by the config plugin as application meta-data because the picker can
+ * launch cold, before any JavaScript has run in the process — so the name has
+ * to be readable without asking JS.
+ */
+object AutofillPickerComponent {
+    // Must match `ANDROID_AUTOFILL_PICKER_META_DATA_NAME` in app.plugin.js.
+    const val META_DATA_NAME = "co.algorand.passkeyautofill.AUTOFILL_PICKER_COMPONENT"
+
+    /** The configured name, or null when unset or blank — the caller fails closed. */
+    fun fromMetaData(metaData: Bundle?): String? =
+        metaData?.getString(META_DATA_NAME)?.trim()?.takeIf { it.isNotEmpty() }
+}
