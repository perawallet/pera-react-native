+package co.algorand.passkeyautofill
+
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.Build
+import android.util.Log
+import androidx.annotation.VisibleForTesting
+import androidx.credentials.provider.CallingAppInfo
+import java.security.MessageDigest
+import org.json.JSONException
+import org.json.JSONObject
+
+/**
+ * PERA LOCAL PATCH — resolves the *web* origin a privileged browser is acting on
+ * behalf of.
+ *
+ * Credential Manager populates `CallingAppInfo.origin` when a browser holding
+ * `android.permission.CREDENTIAL_MANAGER_SET_ORIGIN` makes a WebAuthn call for a
+ * page. That value is the origin the page (and the relying party) expects to see
+ * in clientData; the caller's own `android:apk-key-hash:…` identity is not. But
+ * AndroidX keeps `origin` internal and only exposes it through
+ * [CallingAppInfo.getOrigin], which requires the caller to be matched against a
+ * privileged-app allowlist first — so shipping an allowlist is the only way to
+ * read it, and the check is the point rather than an obstacle: without it any
+ * caller that could set an origin could dictate what we sign it as.
+ *
+ * `res/raw/passkey_privileged_browsers.json` is Google's published allowlist
+ * (https://www.gstatic.com/gpm-passkeys-privileged-apps/apps.json) — the same
+ * set Google Password Manager trusts. `userdebug` fingerprints in it only apply
+ * on `userdebug` builds; AndroidX filters them by `Build.TYPE`.
+ *
+ * The autofill service reuses this same allowlist through [isAllowlistedBrowser]
+ * to answer a different question: may this caller assert a web domain at all?
+ * Autofill hands over an `AssistStructure` whose `webDomain` the client app
+ * wrote itself, with no platform-populated origin to check, so the signing
+ * certificate is the only evidence available. Reusing the list is sound because
+ * the trust it encodes is strictly stronger: an app Google trusts to *dictate*
+ * the origin a WebAuthn assertion is signed over is trusted, by that same
+ * decision, merely to *report* the page it is rendering. Nothing narrower would
+ * be gained by a second list, and two lists would drift apart.
+ *
+ * Every failure path returns null, which means "treat this as an ordinary app
+ * call" — the pre-existing behaviour. A browser missing from the allowlist is
+ * therefore no worse off than before the patch, so refreshing the JSON is
+ * maintenance rather than a correctness dependency.
+ */
+object PrivilegedBrowsers {
+    private const val TAG = "PrivilegedBrowsers"
+    private const val BUILD_USERDEBUG = "userdebug"
+    private const val HEX_DIGITS = "0123456789abcdef"
+
+    @Volatile
+    private var cachedAllowlist: String? = null
+
+    /**
+     * The web origin [info] is acting for (e.g. `https://example.com`), or null
+     * when the caller is not an allowlisted browser or claimed no origin.
+     */
+    fun webOrigin(context: Context, info: CallingAppInfo): String? {
+        if (!info.isOriginPopulated()) return null
+        val allowlist = allowlist(context) ?: return null
+        return try {
+            info.getOrigin(allowlist)
+        } catch (e: IllegalStateException) {
+            // Origin set by a caller that is not on the allowlist. Deliberately
+            // not fatal: we fall back to the app-identity origin rather than
+            // honouring an unverifiable claim.
+            Log.w(TAG, "${info.packageName} claimed a web origin but is not an allowlisted browser")
+            null
+        } catch (e: IllegalArgumentException) {
+            Log.e(TAG, "Privileged browser allowlist is malformed", e)
+            null
+        }
+    }
+
+    private fun allowlist(context: Context): String? {
+        cachedAllowlist?.let { return it }
+        return try {
+            context.resources
+                .openRawResource(R.raw.passkey_privileged_browsers)
+                .bufferedReader()
+                .use { it.readText() }
+                .also { cachedAllowlist = it }
+        } catch (e: Exception) {
+            Log.e(TAG, "Could not read the privileged browser allowlist", e)
+            null
+        }
+    }
+
+    /**
+     * Whether [packageName] is an allowlisted browser whose *installed* signing
+     * certificate matches the allowlist entry.
+     *
+     * The autofill path cannot use [webOrigin]: it never sees a
+     * [CallingAppInfo], only an `AssistStructure` whose `webDomain` the client
+     * app wrote itself. Matching the certificate is what turns that claim into
+     * an identity. A package name on its own proves nothing — anyone can
+     * install an app named `com.android.chrome`, but not one signed by Google.
+     */
+    fun isAllowlistedBrowser(context: Context, packageName: String): Boolean = try {
+        // Checked before touching PackageManager: this runs for every fill
+        // request, and the allowlist lookup rejects ordinary apps without one.
+        val allowed = allowlistFingerprints(context, packageName)
+        if (allowed.isEmpty()) {
+            false
+        } else {
+            val installed = installedSigners(context, packageName)
+            installed.fingerprints.isNotEmpty() &&
+                if (installed.hasMultipleSigners) {
+                    // AndroidX requires *every* signer of a multi-signed package
+                    // to be allowlisted. Accepting on any one of them would let a
+                    // co-signed build carry an allowlisted signer alongside an
+                    // arbitrary one and still pass.
+                    allowed.containsAll(installed.fingerprints)
+                } else {
+                    installed.fingerprints.any { it in allowed }
+                }
+        }
+    } catch (e: Exception) {
+        Log.w(TAG, "Could not verify $packageName against the browser allowlist", e)
+        false
+    }
+
+    private fun allowlistFingerprints(context: Context, packageName: String): Set<String> {
+        val raw = allowlist(context) ?: return emptySet()
+        return parseAllowlistFingerprints(raw, packageName, Build.TYPE == BUILD_USERDEBUG)
+    }
+
+    /**
+     * The fingerprints [raw] lists for [packageName].
+     *
+     * `userdebug` entries are honoured only when [acceptUserdebugSignatures],
+     * matching what AndroidX does with this same file: those certificates sign
+     * engineering builds, so trusting them on a user build would extend trust to
+     * keys that were never meant to carry it.
+     *
+     * Takes the build decision as an argument rather than reading [Build.TYPE]
+     * itself so the parse can be tested without a device.
+     */
+    @VisibleForTesting
+    internal fun parseAllowlistFingerprints(
+        raw: String,
+        packageName: String,
+        acceptUserdebugSignatures: Boolean,
+    ): Set<String> {
+        // Fails closed on its own rather than leaning on isAllowlistedBrowser's
+        // catch: a check on the security boundary must not owe that property to
+        // a caller's error handling, where it is invisible and easily dropped.
+        // Unparseable input and a missing "apps" key converge here.
+        val apps = try {
+            JSONObject(raw).optJSONArray("apps")
+        } catch (e: JSONException) {
+            Log.e(TAG, "Privileged browser allowlist is malformed", e)
+            null
+        } ?: return emptySet()
+        val fingerprints = mutableSetOf<String>()
+        for (i in 0 until apps.length()) {
+            val info = apps.optJSONObject(i)?.optJSONObject("info") ?: continue
+            if (info.optString("package_name") != packageName) continue
+            val signatures = info.optJSONArray("signatures") ?: continue
+            for (j in 0 until signatures.length()) {
+                val signature = signatures.optJSONObject(j) ?: continue
+                if (signature.optString("build") == BUILD_USERDEBUG &&
+                    !acceptUserdebugSignatures
+                ) {
+                    continue
+                }
+                signature.optString("cert_fingerprint_sha256")
+                    .takeIf { it.isNotEmpty() }
+                    ?.let { fingerprints += normalize(it) }
+            }
+        }
+        return fingerprints
+    }
+
+    private class InstalledSigners(
+        val hasMultipleSigners: Boolean,
+        val fingerprints: Set<String>,
+    )
+
+    private fun installedSigners(context: Context, packageName: String): InstalledSigners {
+        val empty = InstalledSigners(hasMultipleSigners = false, fingerprints = emptySet())
+        val packageManager = context.packageManager
+        var multipleSigners = false
+        val signatures = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            val signingInfo = packageManager
+                .getPackageInfo(packageName, PackageManager.GET_SIGNING_CERTIFICATES)
+                .signingInfo ?: return empty
+            multipleSigners = signingInfo.hasMultipleSigners()
+            // A browser that has rotated its signing key still answers for the
+            // package under its older certificate, and the published allowlist
+            // may name either, so a lone signer is compared against its history.
+            if (multipleSigners) {
+                signingInfo.apkContentsSigners
+            } else {
+                signingInfo.signingCertificateHistory
+            }
+        } else {
+            @Suppress("DEPRECATION")
+            // Below API 28 co-signers and one signer's rotation history are the
+            // same flat array, so a rotated-key browser is held to the stricter
+            // containsAll. That declines a legitimate browser rather than
+            // admitting a wrong one: an availability trade, not a hole.
+            packageManager.getPackageInfo(packageName, PackageManager.GET_SIGNATURES).signatures
+                ?.also { multipleSigners = it.size > 1 }
+        } ?: return empty
+
+        // digest() resets the instance, so one is enough for every signature.
+        val digest = MessageDigest.getInstance("SHA-256")
+        return InstalledSigners(
+            hasMultipleSigners = multipleSigners,
+            fingerprints = signatures.mapTo(mutableSetOf()) {
+                toHex(digest.digest(it.toByteArray()))
+            },
+        )
+    }
+
+    /**
+     * Allowlist fingerprints are colon-separated uppercase hex
+     * (`F0:FD:6C:...`) while computed ones are bare lowercase, so both sides are
+     * reduced to the same spelling before they are compared.
+     *
+     * Getting this wrong fails closed and silently: every check would return
+     * false, `Web` scope would be unreachable, and the feature would look
+     * healthy while never filling anything in a browser.
+     */
+    @VisibleForTesting
+    internal fun normalize(fingerprint: String): String =
+        fingerprint.replace(":", "").lowercase()
+
+    /**
+     * Deliberately not `"%02x".format(...)`, which formats in the default
+     * locale and would emit non-ASCII digits under one that shapes them.
+     */
+    @VisibleForTesting
+    internal fun toHex(bytes: ByteArray): String {
+        val out = StringBuilder(bytes.size * 2)
+        for (byte in bytes) {
+            val value = byte.toInt() and 0xFF
+            out.append(HEX_DIGITS[value ushr 4]).append(HEX_DIGITS[value and 0x0F])
+        }
+        return out.toString()
+    }
+}
