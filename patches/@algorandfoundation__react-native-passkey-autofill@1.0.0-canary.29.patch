@@ -0,0 +1,29 @@
+package co.algorand.passkeyautofill.auth
+
+import co.algorand.passkeyautofill.credentials.AssertionUnlock
+
+/**
+ * PERA LOCAL PATCH — whether the assertion activity must show its own prompt.
+ *
+ * This decides UX only. The repository refuses to open key material without
+ * the proof [AssertionUnlock] names, whatever this returns.
+ */
+object AssertionCeremony {
+    /**
+     * @param unlock what the stored credential needs unlocked, from
+     *   [co.algorand.passkeyautofill.credentials.CredentialRepository.assertionUnlock].
+     * @param systemVerified the system's Single Tap prompt succeeded for this operation.
+     * @param hasUnlockedCipher a cipher the user already unlocked for this operation is in hand.
+     */
+    fun needsManualPrompt(
+        unlock: AssertionUnlock,
+        requestedUserVerification: String?,
+        systemVerified: Boolean,
+        hasUnlockedCipher: Boolean,
+    ): Boolean {
+        val verificationRequired =
+            UserVerification.normalize(requestedUserVerification) == UserVerification.REQUIRED
+        return (verificationRequired && !systemVerified) ||
+            (unlock !is AssertionUnlock.None && !hasUnlockedCipher)
+    }
+}
