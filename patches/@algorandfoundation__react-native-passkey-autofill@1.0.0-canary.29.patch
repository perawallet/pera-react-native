+        )
+        assertFalse(
+            AssertionCeremony.needsManualPrompt(
+                AssertionUnlock.None,
+                UserVerification.REQUIRED,
+                systemVerified = true,
+                hasUnlockedCipher = false,
+            ),
+        )
+    }
+
+    @Test
+    fun `a Single Tap cipher satisfies the unlock without a second prompt`() {
+        assertFalse(
+            AssertionCeremony.needsManualPrompt(
+                AssertionUnlock.AuthenticatedCipher,
+                UserVerification.PREFERRED,
+                systemVerified = true,
+                hasUnlockedCipher = true,
+            ),
+        )
+    }
+}
diff --git a/android/src/test/java/co/algorand/passkeyautofill/credentials/CredentialRepositoryAssertionKeysTest.kt b/android/src/test/java/co/algorand/passkeyautofill/credentials/CredentialRepositoryAssertionKeysTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..f728b288f45c85f734205a636a3c33d7c65c66ec
--- /dev/null
+++ b/android/src/test/java/co/algorand/passkeyautofill/credentials/CredentialRepositoryAssertionKeysTest.kt
@@ -0,0 +1,341 @@
+package co.algorand.passkeyautofill.credentials
+
+import android.content.Context
+import android.util.Base64 as AndroidBase64
+import co.algorand.passkeyautofill.auth.BiometricRequirement
+import com.tencent.mmkv.MMKV
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.mockkObject
+import io.mockk.mockkStatic
+import io.mockk.spyk
+import io.mockk.unmockkAll
+import io.mockk.verify
+import java.security.KeyPair
+import java.security.KeyPairGenerator
+import java.security.spec.ECGenParameterSpec
+import javax.crypto.Cipher
+import javax.crypto.KeyGenerator
+import javax.crypto.SecretKey
+import javax.crypto.spec.GCMParameterSpec
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.After
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertThrows
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+/**
+ * The biometric key and the master key live in the AndroidKeyStore, which the
+ * JVM has no provider for: a software AES key stands in for the biometric key,
+ * and the master key is stubbed. The rules under test are the repository's,
+ * not the Keystore's.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class CredentialRepositoryAssertionKeysTest {
+    private val credentialId = ByteArray(32) { it.toByte() }
+    private val storedId = AndroidBase64.encodeToString(credentialId, AndroidBase64.DEFAULT).trim()
+    private val masterKey = ByteArray(KeystoreRecords.MASTER_KEY_LENGTH) { (it + 1).toByte() }
+    private val keystoreRecords = mutableMapOf<String, String>()
+    private val autofillRecords = mutableMapOf<String, String>()
+
+    private lateinit var context: Context
+    private lateinit var repository: Repository
+    private lateinit var storedKeyPair: KeyPair
+    private lateinit var biometricKey: SecretKey
+
+    @Before
+    fun setUp() {
+        context = RuntimeEnvironment.getApplication()
+        mockkStatic(MMKV::class)
+        every { MMKV.initialize(any<Context>()) } returns "mmkv"
+        val keystore = fakeMmkv(keystoreRecords)
+        val autofill = fakeMmkv(autofillRecords)
+        every { MMKV.mmkvWithID(any(), any<Int>()) } answers {
+            if (firstArg<String>() == CredentialRepository.PASSKEYS_MMKV_ID) keystore else autofill
+        }
+
+        repository = spyk(Repository(), recordPrivateCalls = true)
+        every { repository["getMasterKey"](any<Context>()) } answers { masterKey.copyOf() }
+
+        storedKeyPair = KeyPairGenerator.getInstance("EC")
+            .apply { initialize(ECGenParameterSpec("secp256r1")) }
+            .generateKeyPair()
+        biometricKey = KeyGenerator.getInstance("AES").apply { init(256) }.generateKey()
+    }
+
+    @After
+    fun tearDown() {
+        unmockkAll()
+    }
+
+    @Test
+    fun `a wrapped credential read without a cipher throws and is never re-derived`() {
+        storeWrappedCredential()
+
+        assertThrows(UserAuthenticationRequiredException::class.java) {
+            repository.getKeyPair(context, credentialId, null)
+        }
+        verifyNothingDerived()
+    }
+
+    @Test
+    fun `a wrapped credential opens with the cipher that wrapped it`() {
+        val iv = storeWrappedCredential()
+
+        val keyPair = repository.getKeyPair(context, credentialId, decryptCipher(iv))
+
+        assertArrayEquals(storedKeyPair.private.encoded, keyPair!!.private.encoded)
+        verifyNothingDerived()
+    }
+
+    @Test
+    fun `a wrapped credential whose cipher fails to unwrap throws and is never re-derived`() {
+        storeWrappedCredential()
+        val wrongKey = KeyGenerator.getInstance("AES").apply { init(256) }.generateKey()
+        val wrongCipher = Cipher.getInstance("AES/GCM/NoPadding").apply {
+            init(Cipher.DECRYPT_MODE, wrongKey, GCMParameterSpec(128, ByteArray(12)))
+        }
+
+        assertThrows(UserAuthenticationRequiredException::class.java) {
+            repository.getKeyPair(context, credentialId, wrongCipher)
+        }
+        verifyNothingDerived()
+    }
+
+    @Test
+    fun `a wrapped credential that unwraps to unparseable bytes throws and is never re-derived`() {
+        val iv = storeWrappedCredential(privateKey = ByteArray(5))
+
+        val error = assertThrows(IllegalStateException::class.java) {
+            repository.getKeyPair(context, credentialId, decryptCipher(iv))
+        }
+        assertFalse(error is UserAuthenticationRequiredException)
+        verifyNothingDerived()
+    }
+
+    @Test
+    fun `a credential with no material is not re-derived without a cipher`() {
+        storeMetadata(biometricIv = null)
+
+        assertThrows(UserAuthenticationRequiredException::class.java) {
+            repository.getKeyPair(context, credentialId, null)
+        }
+        verifyNothingDerived()
+    }
+
+    @Test
+    fun `a credential with no material is not re-derived with a decrypt-mode cipher`() {
+        storeMetadata(biometricIv = null)
+
+        assertThrows(UserAuthenticationRequiredException::class.java) {
+            repository.getKeyPair(context, credentialId, decryptCipher(ByteArray(12)))
+        }
+        verifyNothingDerived()
+    }
+
+    @Test
+    fun `a credential with no material is re-derived from its pinned parent once a cipher proves the user`() {
+        storeMetadata(biometricIv = null)
+        every { repository.createDomainKeyPair(any(), any(), any(), any()) } returns
+            DerivedDomainKeyPair(storedKeyPair, "parent", KeystoreRecords.SCHEME_PBKDF2_P256)
+
+        val keyPair = repository.getKeyPair(context, credentialId, encryptCipher())
+
+        assertSame(storedKeyPair, keyPair)
+        verify(exactly = 1) {
+            repository.createDomainKeyPair(context, ORIGIN, USER_HANDLE, KeystoreRecords.SCHEME_PBKDF2_P256)
+        }
+    }
+
+    @Test
+    fun `an unwrapped credential opens without a cipher when no PRF secret is asked for`() {
+        storeMetadata(biometricIv = null)
+        storeMaterial(storedKeyPair.private.encoded)
+
+        val keys = repository.openAssertionKeys(context, credentialId, null, includePrfSecret = false)
+
+        assertArrayEquals(storedKeyPair.private.encoded, keys!!.keyPair.private.encoded)
+        assertNull(keys.prfParentSecret)
+        verifyNothingDerived()
+    }
+
+    @Test
+    fun `the PRF parent secret is not read without a proof`() {
+        storeMetadata(biometricIv = null)
+        storeMaterial(storedKeyPair.private.encoded)
+
+        assertThrows(UserAuthenticationRequiredException::class.java) {
+            repository.openAssertionKeys(context, credentialId, null, includePrfSecret = true)
+        }
+        verifyNothingDerived()
+    }
+
+    @Test
+    fun `the PRF parent secret is read once a cipher proves the user`() {
+        storeMetadata(biometricIv = null)
+        storeMaterial(storedKeyPair.private.encoded)
+        val parent = ParentSecret("parent", KeystoreRecords.SCHEME_PBKDF2_P256, ByteArray(32) { 7 })
+        every { repository["resolveParentSecret"](any<Context>(), any<String>()) } returns
+            ParentSecretResult.Available(parent)
+
+        val keys = repository.openAssertionKeys(context, credentialId, encryptCipher(), includePrfSecret = true)
+
+        assertSame(parent, keys!!.prfParentSecret)
+    }
+
+    @Test
+    fun `a wrapped credential's unwrap is the proof for its PRF parent secret`() {
+        val iv = storeWrappedCredential()
+        val parent = ParentSecret("parent", KeystoreRecords.SCHEME_PBKDF2_P256, ByteArray(32) { 7 })
+        every { repository["resolveParentSecret"](any<Context>(), any<String>()) } returns
+            ParentSecretResult.Available(parent)
+
+        val keys = repository.openAssertionKeys(context, credentialId, decryptCipher(iv), includePrfSecret = true)
+
+        assertSame(parent, keys!!.prfParentSecret)
+        verify(exactly = 0) { repository.createDomainKeyPair(any(), any(), any(), any()) }
+    }
+
+    @Test
+    fun `a wrapped credential with no stored material throws and is never re-derived`() {
+        storeMetadata(biometricIv = ByteArray(12))
+
+        val error = assertThrows(IllegalStateException::class.java) {
+            repository.getKeyPair(context, credentialId, encryptCipher())
+        }
+        assertFalse(error is UserAuthenticationRequiredException)
+        verifyNothingDerived()
+    }
+
+    @Test
+    fun `a stored IV that is not base64 is reported as an unreadable record`() {
+        storeMetadata(biometricIv = null, rawIv = "not base64 !!")
+
+        val error = assertThrows(IllegalStateException::class.java) {
+            repository.assertionUnlock(context, credentialId, includePrfSecret = false)
+        }
+        assertFalse(error is UserAuthenticationRequiredException)
+    }
+
+    @Test
+    fun `a requirement that is not crypto-bound re-derives without a proof`() {
+        mockkObject(BiometricRequirement.Companion)
+        every { BiometricRequirement.resolve(any()) } returns BiometricRequirement.WEAK_OR_CREDENTIAL
+        storeMetadata(biometricIv = null)
+        every { repository.createDomainKeyPair(any(), any(), any(), any()) } returns
+            DerivedDomainKeyPair(storedKeyPair, "parent", KeystoreRecords.SCHEME_PBKDF2_P256)
+
+        assertEquals(AssertionUnlock.None, repository.assertionUnlock(context, credentialId, includePrfSecret = false))
+        assertSame(storedKeyPair, repository.getKeyPair(context, credentialId, null))
+    }
+
+    @Test
+    fun `an unknown credential opens nothing`() {
+        assertNull(repository.getKeyPair(context, credentialId, null))
+        assertNull(repository.assertionUnlock(context, credentialId, includePrfSecret = false))
+    }
+
+    @Test
+    fun `assertionUnlock names the stored IV for a wrapped credential`() {
+        val iv = storeWrappedCredential()
+
+        assertEquals(
+            AssertionUnlock.UnwrapCipher(iv),
+            repository.assertionUnlock(context, credentialId, includePrfSecret = false),
+        )
+    }
+
+    @Test
+    fun `assertionUnlock asks for an authenticated cipher when the key must be re-derived`() {
+        storeMetadata(biometricIv = null)
+
+        assertEquals(
+            AssertionUnlock.AuthenticatedCipher,
+            repository.assertionUnlock(context, credentialId, includePrfSecret = false),
+        )
+    }
+
+    @Test
+    fun `assertionUnlock asks for nothing for an unwrapped key unless PRF is requested`() {
+        storeMetadata(biometricIv = null)
+        storeMaterial(storedKeyPair.private.encoded)
+
+        assertEquals(AssertionUnlock.None, repository.assertionUnlock(context, credentialId, includePrfSecret = false))
+        assertEquals(
+            AssertionUnlock.AuthenticatedCipher,
+            repository.assertionUnlock(context, credentialId, includePrfSecret = true),
+        )
+    }
+
+    private fun verifyNothingDerived() {
+        verify(exactly = 0) { repository.createDomainKeyPair(any(), any(), any(), any()) }
+        verify(exactly = 0) { repository["resolveParentSecret"](any<Context>(), any<String>()) }
+    }
+
+    /** Stores the credential the way `saveCredential` does with a biometric cipher, returning the IV. */
+    private fun storeWrappedCredential(privateKey: ByteArray = storedKeyPair.private.encoded): ByteArray {
+        val cipher = encryptCipher()
+        val iv = cipher.iv
+        storeMetadata(biometricIv = iv)
+        storeMaterial(cipher.doFinal(privateKey))
+        return iv
+    }
+
+    private fun storeMetadata(biometricIv: ByteArray?, rawIv: String? = null) {
+        val record = JSONObject()
+            .put("id", storedId)
+            .put("type", "hd-derived-p256")
+            .put("algorithm", "P256")
+            .put("keyUsages", JSONArray(listOf("sign")))
+            .put("publicKey", KeystoreRecords.wrapBytes(storedKeyPair.public.encoded))
+            .put(
+                "metadata",
+                JSONObject()
+                    .put("origin", ORIGIN)
+                    .put("userHandle", USER_HANDLE)
+                    .put("userId", "dXNlcg")
+                    .put("scheme", KeystoreRecords.SCHEME_PBKDF2_P256),
+            )
+        (rawIv ?: biometricIv?.let { AndroidBase64.encodeToString(it, AndroidBase64.NO_WRAP) })?.let {
+            record.put("privateKeyEnc", JSONObject().put("iv", it))
+        }
+        keystoreRecords[KeystoreRecords.metadataKey(storedId)] = record.toString()
+    }
+
+    private fun storeMaterial(material: ByteArray) {
+        keystoreRecords[KeystoreRecords.materialKey(storedId)] = KeystoreRecords.sealMaterial(masterKey, material)
+    }
+
+    private fun encryptCipher(): Cipher =
+        Cipher.getInstance("AES/GCM/NoPadding").apply { init(Cipher.ENCRYPT_MODE, biometricKey) }
+
+    private fun decryptCipher(iv: ByteArray): Cipher =
+        Cipher.getInstance("AES/GCM/NoPadding").apply {
+            init(Cipher.DECRYPT_MODE, biometricKey, GCMParameterSpec(128, iv))
+        }
+
+    private fun fakeMmkv(records: MutableMap<String, String>): MMKV = mockk {
+        every { decodeString(any<String>()) } answers { records[firstArg()] }
+        every { allKeys() } answers { records.keys.toTypedArray() }
+        every { encode(any<String>(), any<String>()) } answers {
+            records[firstArg()] = secondArg()
+            true
+        }
+    }
+
+    private companion object {
+        const val ORIGIN = "https://example.com"
+        const val USER_HANDLE = "alice"
+    }
+}
