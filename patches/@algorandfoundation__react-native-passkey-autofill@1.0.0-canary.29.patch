@@ -0,0 +1,43 @@
+package co.algorand.passkeyautofill.credentials
+
+import java.security.KeyPair
+
+/**
+ * PERA LOCAL PATCH — what one assertion needs, opened under a single proof of user authentication.
+ *
+ * [prfParentSecret] is set only when the caller asked for it and a Keystore
+ * operation that requires user authentication succeeded. The caller zeroes its
+ * `bytes` once the PRF output is computed.
+ */
+class AssertionKeys(val keyPair: KeyPair, val prfParentSecret: ParentSecret?)
+
+/**
+ * PERA LOCAL PATCH — which Keystore operation must be unlocked before
+ * [CredentialRepository.openAssertionKeys] can succeed for a credential.
+ */
+sealed class AssertionUnlock {
+    /** The key is stored unwrapped and nothing else is requested: it opens without a ceremony. */
+    object None : AssertionUnlock()
+
+    /**
+     * The key is re-derived from the parent secret, or the PRF extension needs
+     * that secret: an encryption-mode cipher on the biometric key, unlocked by
+     * the user, proves they authenticated.
+     */
+    object AuthenticatedCipher : AssertionUnlock()
+
+    /** The key is biometric-wrapped: only the decryption cipher for this IV opens it. */
+    data class UnwrapCipher(val iv: ByteArray) : AssertionUnlock() {
+        override fun equals(other: Any?): Boolean = other is UnwrapCipher && iv.contentEquals(other.iv)
+        override fun hashCode(): Int = iv.contentHashCode()
+    }
+}
+
+/**
+ * PERA LOCAL PATCH — key material or the parent secret was requested without a
+ * proof that the user authenticated for this assertion.
+ */
+class UserAuthenticationRequiredException(
+    message: String,
+    cause: Throwable? = null,
+) : IllegalStateException(message, cause)
